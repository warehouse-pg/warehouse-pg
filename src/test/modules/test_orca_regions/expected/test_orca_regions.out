-- the PG planner plans writes to it
INSERT INTO e VALUES (100, 1);
INFO:  GPORCA failed to produce a plan, falling back to Postgres-based planner
DETAIL:  Falling back to Postgres-based planner because GPORCA does not support the following feature: DML on a table an extension reads itself
SELECT count(*) FROM e;
INFO:  GPORCA failed to produce a plan, falling back to Postgres-based planner
DETAIL:  Falling back to Postgres-based planner because GPORCA does not support the following feature: scan of a table an extension reads itself outside its regions
 count 
-------
    31
(1 row)

-- and reads, if the extension says so
SET test_orca_regions.ext_relation = planner;
EXPLAIN (COSTS OFF) SELECT * FROM e;
INFO:  GPORCA failed to produce a plan, falling back to Postgres-based planner
DETAIL:  Falling back to Postgres-based planner because GPORCA does not support the following feature: Table an extension plans with PG's planner
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on e
 Optimizer: Postgres-based planner
(3 rows)

RESET test_orca_regions.mode;
RESET test_orca_regions.ext_relation;
DROP FUNCTION plan_rows(text);
DROP TABLE t, u, e, s;
DROP ACCESS METHOD test_orca_ext;
