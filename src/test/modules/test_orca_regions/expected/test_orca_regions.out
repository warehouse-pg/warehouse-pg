--
-- Test ORCA's orca_plan_regions_hook.
--
-- The segments look up the CustomScan methods of the plans they are sent,
-- so they must load the module too.
DO $$
BEGIN
	EXECUTE format('ALTER DATABASE %I SET session_preload_libraries = %L',
				   current_database(), 'test_orca_regions');
END
$$;
\c
SET optimizer = on;
SET optimizer_trace_fallback = on;
CREATE TABLE t (a int, b int) DISTRIBUTED BY (a);
INSERT INTO t SELECT i, i % 3 FROM generate_series(1, 10) i;
INSERT INTO t VALUES (NULL, 1), (11, NULL);
CREATE TABLE u (c int, d int) DISTRIBUTED BY (c);
INSERT INTO u SELECT i, i FROM generate_series(1, 10) i;
ANALYZE t;
ANALYZE u;
-- no regions: the plan as ORCA chose it
SET test_orca_regions.mode = off;
EXPLAIN (COSTS OFF) SELECT * FROM t WHERE b = 1;
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on t
         Filter: (b = 1)
 Optimizer: GPORCA
(4 rows)

-- a region at each table scan
SET test_orca_regions.mode = scan;
EXPLAIN (COSTS OFF) SELECT * FROM t WHERE b = 1;
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Custom Scan (TestOrcaRegion)
         Region: pass
         ->  Seq Scan on t
               Filter: (b = 1)
 Optimizer: GPORCA
(6 rows)

SELECT * FROM t WHERE b = 1 ORDER BY a;
 a  | b 
----+---
  1 | 1
  4 | 1
  7 | 1
 10 | 1
    | 1
(5 rows)

EXPLAIN (COSTS OFF) SELECT t.a, u.c FROM t JOIN u ON t.b = u.d;
                            QUERY PLAN                            
------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Hash Join
         Hash Cond: ((NULL::integer) = (NULL::integer))
         ->  Redistribute Motion 3:3  (slice2; segments: 3)
               Hash Key: (NULL::integer)
               ->  Custom Scan (TestOrcaRegion)
                     Region: pass
                     ->  Seq Scan on t
         ->  Hash
               ->  Redistribute Motion 3:3  (slice3; segments: 3)
                     Hash Key: (NULL::integer)
                     ->  Custom Scan (TestOrcaRegion)
                           Region: pass
                           ->  Seq Scan on u
 Optimizer: GPORCA
(15 rows)

SELECT t.a, u.c FROM t JOIN u ON t.b = u.d ORDER BY 1, 2;
 a  | c 
----+---
  1 | 1
  2 | 2
  4 | 1
  5 | 2
  7 | 1
  8 | 2
 10 | 1
    | 1
(8 rows)

-- ipc regions: rows cross gather and redistribute motions as
-- (segment, payload) rows
SET test_orca_regions.mode = ipc;
EXPLAIN (COSTS OFF) SELECT * FROM t WHERE b = 1;
                   QUERY PLAN                   
------------------------------------------------
 Custom Scan (TestOrcaRegion)
   Region: decode
   ->  Gather Motion 3:1  (slice1; segments: 3)
         ->  Custom Scan (TestOrcaRegion)
               Region: encode
               ->  Seq Scan on t
                     Filter: (b = 1)
 Optimizer: GPORCA
(8 rows)

SELECT * FROM t WHERE b = 1 ORDER BY a;
 a  | b 
----+---
  1 | 1
  4 | 1
  7 | 1
 10 | 1
    | 1
(5 rows)

SELECT * FROM t ORDER BY a;
 a  | b 
----+---
  1 | 1
  2 | 2
  3 | 0
  4 | 1
  5 | 2
  6 | 0
  7 | 1
  8 | 2
  9 | 0
 10 | 1
 11 |  
    | 1
(12 rows)

EXPLAIN (COSTS OFF) SELECT t.a, u.c FROM t JOIN u ON t.b = u.d;
                                   QUERY PLAN                                    
---------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Hash Join
         Hash Cond: ((NULL::integer) = (NULL::integer))
         ->  Custom Scan (TestOrcaRegion)
               Region: decode
               ->  Explicit Redistribute Motion 3:3  (slice2; segments: 3)
                     ->  Custom Scan (TestOrcaRegion)
                           Region: encode
                           ->  Seq Scan on t
         ->  Hash
               ->  Custom Scan (TestOrcaRegion)
                     Region: decode
                     ->  Explicit Redistribute Motion 3:3  (slice3; segments: 3)
                           ->  Custom Scan (TestOrcaRegion)
                                 Region: encode
                                 ->  Seq Scan on u
 Optimizer: GPORCA
(17 rows)

SELECT t.a, u.c FROM t JOIN u ON t.b = u.d ORDER BY 1, 2;
 a  | c 
----+---
  1 | 1
  2 | 2
  4 | 1
  5 | 2
  7 | 1
  8 | 2
 10 | 1
    | 1
(8 rows)

-- the PG planner doesn't call the hook
SET optimizer = off;
EXPLAIN (COSTS OFF) SELECT * FROM t WHERE b = 1;
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on t
         Filter: (b = 1)
 Optimizer: Postgres-based planner
(4 rows)

SET optimizer = on;
-- malformed regions: the query falls back to the PG planner
SET test_orca_regions.mode = bad_version;
EXPLAIN (COSTS OFF) SELECT * FROM t;
INFO:  GPORCA failed to produce a plan, falling back to Postgres-based planner
DETAIL:  Falling back to Postgres-based planner because GPORCA does not support the following feature: extension regions of another ABI version
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on t
 Optimizer: Postgres-based planner
(3 rows)

SET test_orca_regions.mode = no_methods;
EXPLAIN (COSTS OFF) SELECT * FROM t;
INFO:  GPORCA failed to produce a plan, falling back to Postgres-based planner
DETAIL:  Falling back to Postgres-based planner because GPORCA does not support the following feature: extension regions without CustomScan methods
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on t
 Optimizer: Postgres-based planner
(3 rows)

SET test_orca_regions.mode = bad_root;
EXPLAIN (COSTS OFF) SELECT * FROM t;
INFO:  GPORCA failed to produce a plan, falling back to Postgres-based planner
DETAIL:  Falling back to Postgres-based planner because GPORCA does not support the following feature: invalid extension region
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on t
 Optimizer: Postgres-based planner
(3 rows)

SET test_orca_regions.mode = leaf_outside;
EXPLAIN (COSTS OFF) SELECT * FROM t;
INFO:  GPORCA failed to produce a plan, falling back to Postgres-based planner
DETAIL:  Falling back to Postgres-based planner because GPORCA does not support the following feature: invalid extension region
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on t
 Optimizer: Postgres-based planner
(3 rows)

SET test_orca_regions.mode = nested_leaves;
EXPLAIN (COSTS OFF) SELECT * FROM t;
INFO:  GPORCA failed to produce a plan, falling back to Postgres-based planner
DETAIL:  Falling back to Postgres-based planner because GPORCA does not support the following feature: invalid extension region
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on t
 Optimizer: Postgres-based planner
(3 rows)

SET test_orca_regions.mode = duplicate_root;
EXPLAIN (COSTS OFF) SELECT * FROM t;
INFO:  GPORCA failed to produce a plan, falling back to Postgres-based planner
DETAIL:  Falling back to Postgres-based planner because GPORCA does not support the following feature: invalid extension region
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on t
 Optimizer: Postgres-based planner
(3 rows)

-- a motion can't merge rows by an opaque payload
SET test_orca_regions.mode = sorted_motion;
EXPLAIN (COSTS OFF) SELECT * FROM t ORDER BY a;
INFO:  GPORCA failed to produce a plan, falling back to Postgres-based planner
DETAIL:  Falling back to Postgres-based planner because GPORCA does not support the following feature: ipc extension region below a sorting or filtering motion
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: a
   ->  Sort
         Sort Key: a
         ->  Seq Scan on t
 Optimizer: Postgres-based planner
(6 rows)

SELECT * FROM t ORDER BY a LIMIT 3;
INFO:  GPORCA failed to produce a plan, falling back to Postgres-based planner
DETAIL:  Falling back to Postgres-based planner because GPORCA does not support the following feature: ipc extension region below a sorting or filtering motion
 a | b 
---+---
 1 | 1
 2 | 2
 3 | 0
(3 rows)

-- no regions under row-level security: their DXL lacks the security quals
CREATE ROLE regress_orca_regions;
GRANT SELECT ON t, u TO regress_orca_regions;
ALTER TABLE t ENABLE ROW LEVEL SECURITY;
CREATE POLICY t_small ON t USING (a < 5);
SET test_orca_regions.mode = scan;
SET ROLE regress_orca_regions;
EXPLAIN (COSTS OFF) SELECT * FROM t;
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Seq Scan on t
         Filter: (a < 5)
 Optimizer: GPORCA
(4 rows)

SELECT * FROM t ORDER BY a;
 a | b 
---+---
 1 | 1
 2 | 2
 3 | 0
 4 | 1
(4 rows)

-- also when the table is only in a subquery
EXPLAIN (COSTS OFF) SELECT * FROM u WHERE c IN (SELECT a FROM t);
                QUERY PLAN                
------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Hash Semi Join
         Hash Cond: (u.c = t.a)
         ->  Seq Scan on u
         ->  Hash
               ->  Seq Scan on t
                     Filter: (a < 5)
 Optimizer: GPORCA
(8 rows)

SELECT * FROM u WHERE c IN (SELECT a FROM t) ORDER BY c;
 c | d 
---+---
 1 | 1
 2 | 2
 3 | 3
 4 | 4
(4 rows)

RESET ROLE;
DROP POLICY t_small ON t;
ALTER TABLE t DISABLE ROW LEVEL SECURITY;
REVOKE SELECT ON t, u FROM regress_orca_regions;
DROP ROLE regress_orca_regions;
RESET test_orca_regions.mode;
DROP TABLE t, u;
