-- Snapshot conflicts raised on a hot standby by VACUUM of append-optimized
-- tables (@amname@ variant).
--
-- Recycling a dead segment file truncates the same relfilenode and segment
-- number to zero and hands it back to new inserts, and the btree records
-- written by the index vacuum carry no xid.  Neither would ever cancel a
-- standby reader on its own, so the recycle path has to publish the xid of
-- the transaction that marked the segment AWAITING_DROP before it vacuums
-- the indexes or touches the file.  The cases below hold a standby snapshot
-- across such a recycle and check that the reader is cancelled with the
-- ordinary snapshot-conflict error.
--
-- A VACUUM of an append-optimized table also prunes ordinary heap pages
-- (the aux tables, and pg_stat_last_operation on the coordinator), and any
-- of those can cancel the same reader for its own reasons.  To prove that
-- the cancellation comes from the record written for THIS table, a fault
-- point in the conflict resolver is armed with the table's relfilenode on
-- the content-0 mirror: it fires only when the resolver finds a conflicting
-- backend for a record carrying that relfilenode.  The metadata-tracking
-- update on the coordinator is switched off for the duration of the test.

-- Arm the resolver fault for p_relname's relfilenode on the content-0 mirror.
create or replace function arm_ao_conflict_probe(p_relname text) returns text as $$
declare
    v_filenode text;	/* in func */
begin	/* in func */
    select relfilenode::text into v_filenode	/* in func */
      from gp_dist_random('pg_class')	/* in func */
     where relname = p_relname and gp_segment_id = 0;	/* in func */
    perform gp_inject_fault('resolve_snapshot_conflict', 'reset', dbid)	/* in func */
       from gp_segment_configuration where content = 0 and role = 'm';	/* in func */
    return (select gp_inject_fault('resolve_snapshot_conflict', 'skip', '', '', v_filenode, 1, -1, 0, dbid)	/* in func */
              from gp_segment_configuration where content = 0 and role = 'm');	/* in func */
end;	/* in func */
$$ language plpgsql;

-- Wait for the probe to fire once, then disarm it.
create or replace function await_ao_conflict_probe() returns text as $$
begin	/* in func */
    perform gp_wait_until_triggered_fault('resolve_snapshot_conflict', 1, dbid)	/* in func */
       from gp_segment_configuration where content = 0 and role = 'm';	/* in func */
    return (select gp_inject_fault('resolve_snapshot_conflict', 'reset', dbid)	/* in func */
              from gp_segment_configuration where content = 0 and role = 'm');	/* in func */
end;	/* in func */
$$ language plpgsql;

select gp_inject_fault_infinite('skip_meta_track_update', 'skip', dbid) from gp_segment_configuration where content = -1 and role = 'p';

-- The suite runs with synchronous_commit = remote_apply, so a primary
-- commit returns only after the standby has applied it, which for the
-- VACUUM below means only after the conflicting reader is gone.  No
-- deferral is in effect unless a case says so.
show synchronous_commit;
show vacuum_defer_cleanup_age;

create table hs_ao_recycle_@amname@(a int, b int) using @amname@ distributed by (a);
create index on hs_ao_recycle_@amname@(b);

----------------------------------------------------------------------
-- Case 1: a reader holding a snapshot across the recycle is cancelled.
----------------------------------------------------------------------
1: insert into hs_ao_recycle_@amname@ select i, i from generate_series(1, 30) i;
-- the probe is armed on content 0 only, so content 0 must hold rows that
-- the DELETE below removes; every case inserts this same series
1: select count(*) > 0 from hs_ao_recycle_@amname@ where gp_segment_id = 0 and a % 2 = 0;

-1S: begin transaction isolation level repeatable read;
-1S: select count(*) from hs_ao_recycle_@amname@;

1: select arm_ao_conflict_probe('hs_ao_recycle_@amname@');
1: delete from hs_ao_recycle_@amname@ where a % 2 = 0;
1: vacuum hs_ao_recycle_@amname@;

-1S: select count(*) from hs_ao_recycle_@amname@;
-1S: end;

1: select await_ao_conflict_probe();
1: truncate hs_ao_recycle_@amname@;

----------------------------------------------------------------------
-- Case 2: a recycle deferred by a primary reader.  The first VACUUM marks
-- the segment but cannot recycle it while a primary reader still needs
-- it, so the standby reader survives that VACUUM; the second VACUUM,
-- after the primary reader is gone, recycles and cancels the standby
-- reader, whose snapshot predates the marking transaction.
----------------------------------------------------------------------
1: insert into hs_ao_recycle_@amname@ select i, i from generate_series(1, 30) i;
2: begin transaction isolation level repeatable read;
2: select count(*) from hs_ao_recycle_@amname@;

-1S: begin transaction isolation level repeatable read;
-1S: select count(*) from hs_ao_recycle_@amname@;

1: select arm_ao_conflict_probe('hs_ao_recycle_@amname@');
1: delete from hs_ao_recycle_@amname@ where a % 2 = 0;
1: vacuum hs_ao_recycle_@amname@;

-- nothing was recycled yet: the standby reader is untouched
-1S: select count(*) from hs_ao_recycle_@amname@;

2: end;
1: vacuum hs_ao_recycle_@amname@;

-1S: select count(*) from hs_ao_recycle_@amname@;
-1S: end;

1: select await_ao_conflict_probe();
1: truncate hs_ao_recycle_@amname@;

----------------------------------------------------------------------
-- Case 3: the conflict is decided on the snapshot, not on the relation.
-- A standby reader of an unrelated heap table is cancelled all the same.
----------------------------------------------------------------------
1: insert into hs_ao_recycle_@amname@ select i, i from generate_series(1, 30) i;
1: create table hs_ao_bystander_@amname@(a int) using heap;
1: insert into hs_ao_bystander_@amname@ select generate_series(1, 5);

-1S: begin transaction isolation level repeatable read;
-1S: select count(*) from hs_ao_bystander_@amname@;

1: select arm_ao_conflict_probe('hs_ao_recycle_@amname@');
1: delete from hs_ao_recycle_@amname@ where a % 2 = 0;
1: vacuum hs_ao_recycle_@amname@;

-1S: select count(*) from hs_ao_bystander_@amname@;
-1S: end;

1: select await_ao_conflict_probe();
1: truncate hs_ao_recycle_@amname@;
1: drop table hs_ao_bystander_@amname@;

----------------------------------------------------------------------
-- Case 4: a recycle in another database does not conflict.  The record
-- carries the database OID and the resolver filters on it.
----------------------------------------------------------------------
1: insert into hs_ao_recycle_@amname@ select i, i from generate_series(1, 30) i;
1: create database hs_ao_elsewhere_@amname@;
1q:
1:@db_name hs_ao_elsewhere_@amname@: create table hs_ao_remote(a int, b int) using @amname@ distributed by (a);
1:@db_name hs_ao_elsewhere_@amname@: insert into hs_ao_remote select i, i from generate_series(1, 30) i;

-1S: begin transaction isolation level repeatable read;
-1S: select count(*) from hs_ao_recycle_@amname@;

1:@db_name hs_ao_elsewhere_@amname@: delete from hs_ao_remote where a % 2 = 0;
1:@db_name hs_ao_elsewhere_@amname@: vacuum hs_ao_remote;

-- the reader in this database is untouched
-1S: select count(*) from hs_ao_recycle_@amname@;
-1S: end;

1q:
1: drop database hs_ao_elsewhere_@amname@;
1: truncate hs_ao_recycle_@amname@;

----------------------------------------------------------------------
-- Case 5: vacuum_defer_cleanup_age holds the recycle back on the primary,
-- and with it the conflict, as it holds back heap cleanup.  For a standby
-- that cannot feed its xmin back to the source (no hot_standby_feedback)
-- it is the knob that delays this conflict.  The reader may be cancelled
-- by any of the deferred cleanups the second VACUUM releases, so this
-- case does not use the relfilenode probe; it only shows that the
-- deferred VACUUM spares the reader and the later one does not.
----------------------------------------------------------------------
!\retcode gpconfig -c vacuum_defer_cleanup_age -v 1;
!\retcode gpstop -u;

1: insert into hs_ao_recycle_@amname@ select i, i from generate_series(1, 30) i;

-1S: begin transaction isolation level repeatable read;
-1S: select count(*) from hs_ao_recycle_@amname@;

1: delete from hs_ao_recycle_@amname@ where a % 2 = 0;
1: vacuum hs_ao_recycle_@amname@;

-- deferred: the marking transaction is still within the age window
-1S: select count(*) from hs_ao_recycle_@amname@;

-- one more transaction on the primary moves the window past it
1: create temp table hs_ao_tick(a int);
1: vacuum hs_ao_recycle_@amname@;

-1S: select count(*) from hs_ao_recycle_@amname@;
-1S: end;

1: drop table hs_ao_tick;
!\retcode gpconfig -r vacuum_defer_cleanup_age;
!\retcode gpstop -u;

1: truncate hs_ao_recycle_@amname@;

----------------------------------------------------------------------
-- Case 6: the recycled segment is refilled straight away.  Without the
-- conflict record a reader that survived the recycle would read the new
-- rows at the old offsets as if they belonged to its snapshot; the reader
-- must be cancelled while replay catches up, never returning rows.
----------------------------------------------------------------------
1: insert into hs_ao_recycle_@amname@ select i, i from generate_series(1, 30) i;

-1S: begin transaction isolation level repeatable read;
-1S: select count(*) from hs_ao_recycle_@amname@;

1: delete from hs_ao_recycle_@amname@ where a % 2 = 0;
1: vacuum hs_ao_recycle_@amname@;
1: insert into hs_ao_recycle_@amname@ select i, -i from generate_series(31, 60) i;

-1S: select count(*) from hs_ao_recycle_@amname@;
-1S: end;

-- cleanup
1: drop table hs_ao_recycle_@amname@;
select gp_inject_fault('skip_meta_track_update', 'reset', dbid) from gp_segment_configuration where content = -1 and role = 'p';
select gp_inject_fault('resolve_snapshot_conflict', 'reset', dbid) from gp_segment_configuration where content = 0 and role = 'm';
drop function await_ao_conflict_probe();
drop function arm_ao_conflict_probe(text);
