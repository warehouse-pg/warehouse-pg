-- Enable auto-ANALYZE only on AUTOVACUUM launcher. When set `autovacuum` to
-- true on Coordinator, the launcher will take care of databases' analyze job on Coordinator.
-- VACUUM anti-XID wraparounds of 'template0' is not changed.

-- Speed up test
!\retcode gpconfig -c autovacuum_naptime -v 1 --skipvalidation;
!\retcode gpconfig -c autovacuum_vacuum_threshold -v 50 --skipvalidation;
-- Use only 1 worker to make for an easier to understand test.
!\retcode gpconfig -c autovacuum_max_workers -v 1 --skipvalidation;
!\retcode gpstop -ar;

-- WHPG: a backend sends its table counts to the stats collector only when
-- it goes idle, and at most once every PGSTAT_STAT_INTERVAL (500ms).  If the
-- worker resumes before the counts of the test's DML have arrived, it does
-- not see the tables as needing ANALYZE.  So the DML runs in its own session,
-- which then quits: a backend sends its counts at exit regardless of the
-- interval.  Then we wait until the collector has them; this returns false if
-- they do not arrive in time, so that a timeout shows up as a diff.
CREATE FUNCTION wait_for_tabstat(rels regclass[]) RETURNS boolean AS $$ /* in func */
BEGIN /* in func */
	FOR i IN 1 .. 600 LOOP /* in func */
		PERFORM pg_stat_clear_snapshot(); /* in func */
		IF NOT EXISTS (SELECT 1 FROM unnest(rels) r /* in func */
					   WHERE coalesce((SELECT n_mod_since_analyze /* in func */
									 FROM pg_stat_all_tables /* in func */
									WHERE relid = r), 0) = 0) THEN /* in func */
			RETURN true; /* in func */
		END IF; /* in func */
		PERFORM pg_sleep(0.1); /* in func */
	END LOOP; /* in func */
	RETURN false; /* in func */
END /* in func */
$$ LANGUAGE plpgsql;

--
-- Test1, vanilla heap and AO table.
--

CREATE TABLE anatest (id bigint);
CREATE TABLE anatest_row (id bigint) using ao_row;
CREATE TABLE anatest_column (id bigint) using ao_column;

-- Suspend worker at the start of a fresh cycle on the current database.
SELECT gp_inject_fault('auto_vac_worker_before_do_autovacuum', 'suspend', '', 'isolation2test', '', 1, 1, 0, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_wait_until_triggered_fault('auto_vac_worker_before_do_autovacuum', 1, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

SELECT gp_inject_fault('auto_vac_worker_after_do_autovacuum', 'skip', '', 'isolation2test', '', 1, 1, 0, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

-- Do stuff that is autoanalyze worthy.
1: INSERT INTO anatest select i from generate_series(1, 1000) as i;
1: INSERT INTO anatest_row select i from generate_series(1, 1000) as i;
1: INSERT INTO anatest_column select i from generate_series(1, 1000) as i;
1q:
SELECT wait_for_tabstat('{anatest,anatest_row,anatest_column}');

-- Resume suspended worker's current cycle and wait up to end of the cycle.
SELECT gp_inject_fault('auto_vac_worker_before_do_autovacuum', 'reset', dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_wait_until_triggered_fault('auto_vac_worker_after_do_autovacuum', 1, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

-- Assert that statistics are updated.
SELECT tablename, count(*) FROM pg_stats where tablename LIKE 'anatest%' GROUP BY tablename ORDER BY 1;
SELECT relname, relpages, reltuples FROM pg_class WHERE relname LIKE 'anatest%' ORDER BY 1;

--
-- Test2a, sanity test to make sure auto-analyze works on partition leaf tables
--

CREATE TABLE rankpart (id int, rank int, product int) DISTRIBUTED BY (id) PARTITION BY RANGE (rank) ( START (1) END (10) EVERY (2), DEFAULT PARTITION extra );
CREATE STATISTICS dep(dependencies) on rank, product from rankpart;

-- Suspend worker at the start of a fresh cycle on the current database.
SELECT gp_inject_fault('auto_vac_worker_before_do_autovacuum', 'suspend', '', 'isolation2test', '', 1, 1, 0, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_inject_fault('auto_vac_worker_after_do_autovacuum', 'reset', dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_wait_until_triggered_fault('auto_vac_worker_before_do_autovacuum', 1, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

SELECT gp_inject_fault('auto_vac_worker_after_do_autovacuum', 'skip', '', 'isolation2test', '', 1, 1, 0, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

-- Do stuff that is autoanalyze worthy.
-- Insert to all leaves except rankpart_1_prt_6
1: insert into rankpart select i, i % 8, i from generate_series(1, 1000)i;
1q:
SELECT wait_for_tabstat('{rankpart_1_prt_extra,rankpart_1_prt_2,rankpart_1_prt_3,rankpart_1_prt_4,rankpart_1_prt_5}');

-- Resume suspended worker's current cycle and wait up to end of the cycle.
SELECT gp_inject_fault('auto_vac_worker_before_do_autovacuum', 'reset', dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_wait_until_triggered_fault('auto_vac_worker_after_do_autovacuum', 1, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

-- Assert that statistics are updated.
SELECT count(*) FROM pg_statistic where starelid = 'rankpart_1_prt_extra'::regclass;
SELECT count(*) FROM pg_statistic where starelid = 'rankpart_1_prt_2'::regclass;
SELECT count(*) FROM pg_statistic where starelid = 'rankpart_1_prt_3'::regclass;
SELECT count(*) FROM pg_statistic where starelid = 'rankpart_1_prt_4'::regclass;
SELECT count(*) FROM pg_statistic where starelid = 'rankpart_1_prt_5'::regclass;
SELECT count(*) FROM pg_statistic where starelid = 'rankpart_1_prt_6'::regclass;
SELECT count(*) FROM pg_statistic where starelid = 'rankpart'::regclass;
select relpages, reltuples from pg_class where oid = 'rankpart_1_prt_extra'::regclass;
select relpages, reltuples from pg_class where oid = 'rankpart_1_prt_2'::regclass;
select relpages, reltuples from pg_class where oid = 'rankpart_1_prt_3'::regclass;
select relpages, reltuples from pg_class where oid = 'rankpart_1_prt_4'::regclass;
select relpages, reltuples from pg_class where oid = 'rankpart_1_prt_5'::regclass;
select relpages, reltuples from pg_class where oid = 'rankpart_1_prt_6'::regclass;
select relpages, reltuples from pg_class where oid = 'rankpart'::regclass;

--
-- Test2b, Insert data into rankpart_1_prt_6, check that root partition stats are updated
--

-- Suspend worker at the start of a fresh cycle on the current database.
SELECT gp_inject_fault('auto_vac_worker_before_do_autovacuum', 'suspend', '', 'isolation2test', '', 1, 1, 0, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_inject_fault('auto_vac_worker_after_do_autovacuum', 'reset', dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_wait_until_triggered_fault('auto_vac_worker_before_do_autovacuum', 1, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

SELECT gp_inject_fault('auto_vac_worker_after_do_autovacuum', 'skip', '', 'isolation2test', '', 1, 1, 0, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

-- Do stuff that is autoanalyze worthy.
-- Insert data into final partition to trigger stats collection for root partition
1: insert into rankpart select i, (i%2)+8, i from generate_series(1,8000)i;
1q:
SELECT wait_for_tabstat('{rankpart_1_prt_5,rankpart_1_prt_6}');

-- Resume suspended worker's current cycle and wait up to end of the cycle.
SELECT gp_inject_fault('auto_vac_worker_before_do_autovacuum', 'reset', dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_wait_until_triggered_fault('auto_vac_worker_after_do_autovacuum', 1, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

-- Since all partitions have been analyzed, statistics should have been collected for root
SELECT count(*) FROM pg_statistic where starelid = 'rankpart_1_prt_6'::regclass;
SELECT count(*) FROM pg_statistic where starelid = 'rankpart_1_prt_5'::regclass;
SELECT count(*) FROM pg_statistic where starelid = 'rankpart_1_prt_2'::regclass;
SELECT count(*) FROM pg_statistic where starelid = 'rankpart'::regclass;
SELECT relpages, reltuples FROM pg_class WHERE oid = 'rankpart_1_prt_6'::regclass;
SELECT relpages, reltuples FROM pg_class WHERE oid = 'rankpart_1_prt_5'::regclass;
SELECT relpages, reltuples FROM pg_class where oid = 'rankpart'::regclass;
-- Extended stats should not have been collected
SELECT d.stxddependencies FROM pg_statistic_ext s, pg_statistic_ext_data d WHERE s.stxrelid = 'rankpart'::regclass AND d.stxoid = s.oid;

--
-- Test3, if another transaction want to acquire lock which conflict with
-- auto-analyze's ShareUpdateExclusiveLock, the auto-analyze should abort on
-- the conflicting table and move on.
--

CREATE TABLE anaabort(id int);

-- Suspend worker at the start of a fresh cycle on the current database.
SELECT gp_inject_fault('auto_vac_worker_before_do_autovacuum', 'suspend', '', 'isolation2test', '', 1, 1, 0, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_inject_fault('auto_vac_worker_after_do_autovacuum', 'reset', dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_wait_until_triggered_fault('auto_vac_worker_before_do_autovacuum', 1, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

SELECT gp_inject_fault('auto_vac_worker_after_do_autovacuum', 'skip', '', 'isolation2test', '', 1, 1, 0, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

-- Do stuff that is autoanalyze worthy.
1: INSERT INTO anaabort select i from generate_series(1, 1000) as i;
1q:
SELECT wait_for_tabstat('{anaabort}');

-- Track the autovacuum worker abort for conflict ShareUpdateExclusiveLock.
SELECT gp_inject_fault('auto_vac_worker_abort', 'skip', '', '', 'anaabort', 1, 1, 0, 1);
-- Suspend after the autovacuum worker after holds ShareUpdateExclusiveLock.
SELECT gp_inject_fault('analyze_after_hold_lock', 'infinite_loop', '', '', 'anaabort', 1, 1, 0, 1);
SELECT gp_inject_fault('auto_vac_worker_before_do_autovacuum', 'reset', dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_wait_until_triggered_fault('analyze_after_hold_lock', 1, 1);

-- Acquire conflicting EXCLUSIVE lock on the table.
1: BEGIN;
1&: LOCK TABLE anaabort in EXCLUSIVE mode;

-- The worker should have aborted on the table and moved on to the end of its cycle.
SELECT gp_wait_until_triggered_fault('auto_vac_worker_abort', 1, 1);
SELECT gp_inject_fault('auto_vac_worker_abort', 'reset', 1);
SELECT gp_wait_until_triggered_fault('auto_vac_worker_after_do_autovacuum', 1, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

-- Get lock
1<:

-- Shouldn't have statistic updated.
SELECT count(*) FROM pg_statistic where starelid = 'anaabort'::regclass;
select relpages, reltuples from pg_class where oid = 'anaabort'::regclass;

1: END;

SELECT gp_inject_fault('auto_vac_worker_after_do_autovacuum', 'reset', dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

--
-- Test4, auto-ANALYZE and auto_stats could work at the same time.
-- With `on_no_stats` mode, if insert into a empty table, ANALYZE gets triggered.
-- But this doesn't prevent auto-ANALYZE for the table. (Case 1)
-- And for `on_change` mode, if the modified tuples reach the auto_stats threshold,
-- auto_stats will get triggered, this also doesn't prevent auto-ANALYZE. (Case 2)
-- But, if not reach the auto_stats threshold, then only auto-ANALYZE will be considered. (Case 3)
-- More details, please refer to the Implementation part of
-- src/backend/postmaster/README.auto-ANALYZE.
--

-- The worker's own stats report can reach the collector after the cycle ends,
-- so poll autoanalyze_count instead of reading it once.
CREATE FUNCTION wait_for_autoanalyze(rel regclass, cnt int) RETURNS boolean AS $$ /* in func */
BEGIN /* in func */
	FOR i IN 1 .. 600 LOOP /* in func */
		PERFORM pg_stat_clear_snapshot(); /* in func */
		IF (SELECT autoanalyze_count FROM pg_stat_all_tables WHERE relid = rel) >= cnt THEN /* in func */
			RETURN true; /* in func */
		END IF; /* in func */
		PERFORM pg_sleep(0.1); /* in func */
	END LOOP; /* in func */
	RETURN false; /* in func */
END /* in func */
$$ LANGUAGE plpgsql;

CREATE TABLE autostatstbl (id bigint);

-- Case 1 --
SELECT gp_inject_fault('auto_vac_worker_before_do_autovacuum', 'suspend', '', 'isolation2test', '', 1, 1, 0, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_wait_until_triggered_fault('auto_vac_worker_before_do_autovacuum', 1, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

SELECT gp_inject_fault('auto_vac_worker_after_do_autovacuum', 'skip', '', 'isolation2test', '', 1, 1, 0, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

-- with auto_stats, the auto-ANALYZE still trigger
1: SET gp_autostats_mode = 'on_no_stats';
1: INSERT INTO autostatstbl select i from generate_series(1, 1000) as i;
1q:
SELECT wait_for_tabstat('{autostatstbl}');

-- auto_stats executed but auto-ANALYZE not execute yet since the worker is suspended.
select relpages, reltuples from pg_class where oid = 'autostatstbl'::regclass;
select analyze_count, autoanalyze_count, n_mod_since_analyze from pg_stat_all_tables where relname = 'autostatstbl';

SELECT gp_inject_fault('auto_vac_worker_before_do_autovacuum', 'reset', dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_wait_until_triggered_fault('auto_vac_worker_after_do_autovacuum', 1, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

-- auto-ANALYZE executed as well.
SELECT wait_for_autoanalyze('autostatstbl', 1);
select relpages, reltuples from pg_class where oid = 'autostatstbl'::regclass;
select analyze_count, autoanalyze_count, n_mod_since_analyze from pg_stat_all_tables where relname = 'autostatstbl';

-- Case 2 --
SELECT gp_inject_fault('auto_vac_worker_before_do_autovacuum', 'suspend', '', 'isolation2test', '', 1, 1, 0, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_inject_fault('auto_vac_worker_after_do_autovacuum', 'reset', dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_wait_until_triggered_fault('auto_vac_worker_before_do_autovacuum', 1, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

SELECT gp_inject_fault('auto_vac_worker_after_do_autovacuum', 'skip', '', 'isolation2test', '', 1, 1, 0, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

-- reach the auto_stats threshold, both auto_stats and auto-ANALYZE trigger
1: SET gp_autostats_mode = 'on_change';
1: SET gp_autostats_on_change_threshold = 500;
1: INSERT INTO autostatstbl select i from generate_series(1001, 2000) as i;
1q:
SELECT wait_for_tabstat('{autostatstbl}');

select relpages, reltuples from pg_class where oid = 'autostatstbl'::regclass;
select analyze_count, autoanalyze_count, n_mod_since_analyze from pg_stat_all_tables where relname = 'autostatstbl';

SELECT gp_inject_fault('auto_vac_worker_before_do_autovacuum', 'reset', dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_wait_until_triggered_fault('auto_vac_worker_after_do_autovacuum', 1, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

SELECT wait_for_autoanalyze('autostatstbl', 2);
select relpages, reltuples from pg_class where oid = 'autostatstbl'::regclass;
select analyze_count, autoanalyze_count, n_mod_since_analyze from pg_stat_all_tables where relname = 'autostatstbl';

-- Case 3 --
SELECT gp_inject_fault('auto_vac_worker_before_do_autovacuum', 'suspend', '', 'isolation2test', '', 1, 1, 0, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_inject_fault('auto_vac_worker_after_do_autovacuum', 'reset', dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_wait_until_triggered_fault('auto_vac_worker_before_do_autovacuum', 1, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

SELECT gp_inject_fault('auto_vac_worker_after_do_autovacuum', 'skip', '', 'isolation2test', '', 1, 1, 0, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

-- not reach the auto_stats threshold (default), only auto-ANALYZE triggers
1: SET gp_autostats_mode = 'on_change';
1: INSERT INTO autostatstbl select i from generate_series(2001, 3000) as i;
1q:
SELECT wait_for_tabstat('{autostatstbl}');

select relpages, reltuples from pg_class where oid = 'autostatstbl'::regclass;
select analyze_count, autoanalyze_count, n_mod_since_analyze from pg_stat_all_tables where relname = 'autostatstbl';

SELECT gp_inject_fault('auto_vac_worker_before_do_autovacuum', 'reset', dbid)
	from gp_segment_configuration where content = -1 and role = 'p';
SELECT gp_wait_until_triggered_fault('auto_vac_worker_after_do_autovacuum', 1, dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

SELECT wait_for_autoanalyze('autostatstbl', 3);
select relpages, reltuples from pg_class where oid = 'autostatstbl'::regclass;
select analyze_count, autoanalyze_count, n_mod_since_analyze from pg_stat_all_tables where relname = 'autostatstbl';

SELECT gp_inject_fault('auto_vac_worker_after_do_autovacuum', 'reset', dbid)
	from gp_segment_configuration where content = -1 and role = 'p';

DROP FUNCTION wait_for_autoanalyze(regclass, int);

DROP FUNCTION wait_for_tabstat(regclass[]);

-- Reset GUCs.
!\retcode gpconfig -r autovacuum_naptime --skipvalidation;
!\retcode gpconfig -r autovacuum_vacuum_threshold --skipvalidation;
!\retcode gpconfig -r autovacuum_max_workers --skipvalidation;
!\retcode gpstop -ar -M fast;
