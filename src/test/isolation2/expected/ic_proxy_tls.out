-- The killed proxy's connections ended with a bare TCP close; the remote
-- proxies must read that as EOF, not as a TLS failure.  Nothing so far
-- gave the proxies a reason for a WARNING.
2: SELECT count(*) AS tls_warnings FROM gp_toolkit.gp_log_system WHERE logtime > (SELECT max(logtime) FROM gp_toolkit.__gp_log_coordinator_ext WHERE logmessage = 'ic_proxy_tls: test start') AND logseverity = 'WARNING' AND logmessage LIKE 'ic-proxy TLS:%';
