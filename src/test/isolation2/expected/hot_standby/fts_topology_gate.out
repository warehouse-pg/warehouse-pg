----------------------------------------------------------------
-- Rebuild the standby for the tests that follow
----------------------------------------------------------------
-- keep the promoted node's log next to the data directories: gpinitstandby
-- deletes the directory, and that log is the only record of what the
-- workers did (CI uploads it on failure)
select pg_ctl(datadir, 'stop', 'immediate') from gp_segment_configuration where content = -1 and role = 'm';
 pg_ctl 
--------
 OK     
(1 row)
!\retcode shost=$(psql -X -d postgres -Atc "select hostname from gp_segment_configuration where content = -1 and role = 'm'"); sport=$(psql -X -d postgres -Atc "select port from gp_segment_configuration where content = -1 and role = 'm'"); sdir=$(psql -X -d postgres -Atc "select datadir from gp_segment_configuration where content = -1 and role = 'm'"); keep="${sdir%/}.fts_topology_gate"; rm -rf "$keep" && mkdir -p "$keep" && cp -R "$sdir/log" "$keep/log" && gpinitstandby -ar > "$keep/gpinitstandby.log" 2>&1 && gpinitstandby -a -s "$shost" -S "$sdir" -P "$sport" >> "$keep/gpinitstandby.log" 2>&1;
-- start_ignore

