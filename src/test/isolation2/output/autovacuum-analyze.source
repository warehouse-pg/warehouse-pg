--
-- Test4, auto-ANALYZE and auto_stats could work at the same time.
-- With `on_no_stats` mode, if insert into a empty table, ANALYZE gets triggered.
-- But this doesn't prevent auto-ANALYZE for the table. (Case 1)
-- And for `on_change` mode, if the modified tuples reach the auto_stats threshold,
-- auto_stats will get triggered, this also doesn't prevent auto-ANALYZE. (Case 2)
-- But, if not reach the auto_stats threshold, then only auto-ANALYZE will be considered. (Case 3)
-- More details, please refer to the Implementation part of
-- src/backend/postmaster/README.auto-ANALYZE.
--

-- The worker's own stats report can reach the collector after the cycle ends,
-- so poll autoanalyze_count instead of reading it once.
CREATE FUNCTION wait_for_autoanalyze(rel regclass, cnt int) RETURNS boolean AS $$ /* in func */ BEGIN /* in func */ FOR i IN 1 .. 600 LOOP /* in func */ PERFORM pg_stat_clear_snapshot(); /* in func */ IF (SELECT autoanalyze_count FROM pg_stat_all_tables WHERE relid = rel) >= cnt THEN /* in func */ RETURN true; /* in func */ END IF; /* in func */ PERFORM pg_sleep(0.1); /* in func */ END LOOP; /* in func */ RETURN false; /* in func */ END /* in func */ $$ LANGUAGE plpgsql;
CREATE FUNCTION

CREATE TABLE autostatstbl (id bigint);
CREATE TABLE

