-- DDL issued from functions
do $$
begin
  create table t_do (a int, b text) distributed by (a);
  alter table t_do alter column b type varchar(3);
end $$;
create function attver_mk() returns void language plpgsql as $$
begin
  execute 'create table t_fn (a int, b ct) distributed by (a)';
  execute 'alter table t_fn add column c int';
end $$;
select attver_mk();
 attver_mk 
