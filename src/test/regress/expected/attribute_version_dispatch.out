--
-- Attribute versions (see src/backend/catalog/README.attver.md) are chosen
-- by the coordinator and dispatched to the segments, so that a composite
-- datum formed on one node can be checked on any other node.  Verify that
-- all nodes store the same version for every attribute, whatever statement
-- created or changed it.
--
create schema attver_dispatch;
set search_path = attver_dispatch;
-- Attributes of relations in this schema whose stored version differs
-- between any two nodes, or that have no version at all.
create view attver_mismatch as
  with allrows as (
    select -1 as segid, attrelid, attnum, attoptions::text as opts
      from pg_attribute
    union all
    select gp_segment_id, attrelid, attnum, attoptions::text
      from gp_dist_random('pg_attribute'))
  select c.relname, a.attnum
    from allrows a
    join pg_class c on c.oid = a.attrelid
    where c.relnamespace = 'attver_dispatch'::regnamespace
      and c.reltype <> 0 and a.attnum > 0
    group by c.relname, a.attnum
    having count(distinct coalesce(a.opts, '')) <> 1
        or count(*) <> (select count(*) + 1 from gp_segment_configuration
                        where role = 'p' and content >= 0)
        or bool_or(a.opts is null or a.opts not like '%pg_attver=%');
-- relation creation
create table t_heap (a int, b text, c bytea) distributed by (a);
create table t_ao (a int, b text) with (appendonly=true) distributed by (a);
create table t_aoco (a int, b text) with (appendonly=true, orientation=column) distributed by (a);
create type ct as (x int, y text);
create table t_base (a int, b text) distributed by (a);
create view v as select a, b from t_base;
create materialized view mv as select a, b from t_base distributed by (a);
create table t_ctas as select a, b from t_base distributed by (a);
select a, b into t_into from t_base;
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column(s) named 'a' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
create table t_like (like t_heap) distributed by (a);
create table t_inh (d int) inherits (t_heap) distributed by (a);
create table p (a int, b int, c text) partition by range (b) distributed by (a);
create table p1 partition of p for values from (0) to (10);
NOTICE:  table has parent, setting distribution columns to match parent table
create table p2 partition of p for values from (10) to (20) partition by list (a);
NOTICE:  table has parent, setting distribution columns to match parent table
create table p21 partition of p2 for values in (1, 2, 3);
NOTICE:  table has parent, setting distribution columns to match parent table
create table t_legacy (a int, b int) distributed by (a)
  partition by range (b) (start (0) end (2) every (1));
create external web table t_ext (a int, b text) execute 'echo 1,a' format 'csv';
select * from attver_mismatch;
 relname | attnum 
---------+--------
(0 rows)

-- attribute changes
insert into t_heap select g, 'x', 'y' from generate_series(1, 20) g;
alter table t_heap add column d int;
NOTICE:  merging definition of column "d" for child "t_inh"
alter table t_heap alter column b type varchar(10);
alter table t_heap alter column c type text, alter column d type bigint;
alter table t_heap alter column b type text, add column e int,
  alter column c type bytea using c::bytea;
alter table t_heap drop column d;
alter table t_ao add column c int default 5;
alter table t_ao alter column b type varchar(9);
alter table t_aoco add column c int;
alter table t_aoco alter column b type varchar(9);
alter type ct add attribute z int;
alter type ct alter attribute x type bigint;
alter table p add column d int, add column e text;
alter table p alter column c type varchar(20);
alter table t_legacy add column c text;
alter table t_legacy alter column c type varchar(5);
select * from attver_mismatch;
 relname | attnum 
---------+--------
