-- Versions only grow, and attributes after an altered one get its version.
select bool_and(v1 <= v2) as monotonic
  from (select substring(attoptions::text from 'pg_attver=(\d+)')::numeric as v1,
               lead(substring(attoptions::text from 'pg_attver=(\d+)')::numeric)
                 over (order by attnum) as v2
          from pg_attribute
          where attrelid = 't_heap'::regclass and attnum > 0) s;
 monotonic 
-----------
 t
(1 row)

-- A composite value formed on the segments before the type changed is
-- rejected on the coordinator, and the other way around.
create type ht as (id int, b bytea);
create table hsrc (id int, b bytea) distributed by (id);
insert into hsrc select g, 'FIXME' from generate_series(1, 100) g;
begin;
declare c cursor for select row(id, b)::ht from hsrc;
fetch 1 from c \gset ignored_
alter type ht alter attribute b type text;
fetch all from c;
ERROR:  row type of datum tuple was altered after the datum's creation
HINT:  See server log for additional details.
rollback;
do $$
declare v ht := row(1, 'FIXME')::ht; r text;
begin
  alter type ht alter attribute b type text;
  select count(*) into r from hsrc where (v).id = id;
  raise notice 'not reached: %', r;
end $$;
ERROR:  row type of datum tuple was altered after the datum's creation
HINT:  See server log for additional details.
CONTEXT:  SQL statement "select count(*)        from hsrc where (v).id = id"
PL/pgSQL function inline_code_block line 5 at SQL statement
reset search_path;
set client_min_messages = warning;
drop schema attver_dispatch cascade;
reset client_min_messages;
