-- table rewrites and rollbacks
alter table t_heap set distributed by (b);
alter table t_heap set with (reorganize=true);
vacuum full t_heap;
create index t_heap_a_idx on t_heap (a);
cluster t_heap using t_heap_a_idx;
create table p_ex (like p1) distributed by (a);
alter table p exchange partition for (5) with table p_ex;
begin;
alter table t_heap add column f int;
alter table t_heap alter column e type bigint;
rollback;
alter table t_heap add column g int;
begin;
savepoint s;
alter table t_ao alter column c type bigint;
rollback to s;
alter table t_ao alter column c type numeric;
commit;
select * from attver_mismatch;
