               ->  Seq Scan on bar_1_prt_p_eu b_1
                     Filter: (region = ANY ('{US,CA,UK,DE,JP,XX,YY}'::text[]))
               ->  Seq Scan on bar_1_prt_p_asia b_2
                     Filter: (region = ANY ('{US,CA,UK,DE,JP,XX,YY}'::text[]))
               ->  Seq Scan on bar_1_prt_lp_default b_3
                     Filter: (region = ANY ('{US,CA,UK,DE,JP,XX,YY}'::text[]))
         ->  Hash
               ->  Append
                     ->  Seq Scan on baz_1_prt_c_east c
                           Filter: (country = ANY ('{US,JP}'::text[]))
                     ->  Seq Scan on baz_1_prt_c_west c_1
                           Filter: (country = ANY ('{US,JP}'::text[]))
 Optimizer: Postgres-based planner
(19 rows)

SELECT count(*) FROM bar b JOIN baz c ON b.id = c.id
WHERE b.region IN ('US','CA','UK','DE','JP','XX','YY')
  AND c.country IN ('US','JP');                                       -- expected: 4
 count 
-------
     4
(1 row)

