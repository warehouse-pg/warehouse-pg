(1 row)

--
-- ================= 4. Adaptive ordering =================
--
-- Two segfiles per segment, so that an order learnt on the first is applied
-- to the second: the first batch, a DELETE of a fifth of it (above the
-- compaction threshold), a VACUUM that compacts the rest into a fresh segfile
-- and another that drops the old one, then a second batch into the emptied
-- segfile.
--
--   p: 1 on one row in thirty (Phase A)
--   q: 1 on every row -- a stage that rejects nothing
--   r: 1 on one row in seven
CREATE TABLE gp_adapt(a int, p int, q int, r int, c text)
  USING ao_column WITH (compresstype = zstd, compresslevel = 1) DISTRIBUTED BY (a);
INSERT INTO gp_adapt
  SELECT i, CASE WHEN i % 30 = 0 THEN 1 ELSE 0 END, 1,
         CASE WHEN i % 7 = 0 THEN 1 ELSE 0 END, 'payload ' || i
    FROM generate_series(1, 300000) i;
DELETE FROM gp_adapt WHERE a % 5 = 1;
VACUUM gp_adapt;
VACUUM gp_adapt;
INSERT INTO gp_adapt
  SELECT i, CASE WHEN i % 30 = 0 THEN 1 ELSE 0 END, 1,
         CASE WHEN i % 7 = 0 THEN 1 ELSE 0 END, 'payload ' || i
    FROM generate_series(300001, 600000) i;
ANALYZE gp_adapt;
SELECT segment_id, count(DISTINCT segno) AS segfiles
  FROM gp_toolkit.__gp_aocsseg('gp_adapt') WHERE tupcount > 0 AND state = 1
 GROUP BY 1 ORDER BY 1;
 segment_id | segfiles 
------------+----------
          0 |        2
          1 |        2
          2 |        2
(3 rows)

-- Mislead the planner into the order p, q, r with planted statistics, the
-- stale-statistics situation the reordering exists for: p = 1 keeps 0.1%
-- (really one row in thirty) so it leads, q = 1 keeps 2% (really every
-- row) and is clustered, so it is staged ahead of r, where it rejects
-- nothing.
SELECT gio_plant('gp_adapt', 'p', '{0.999,0.001}', 0.9);
