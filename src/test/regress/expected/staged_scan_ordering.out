 t
(1 row)

-- A clause that can fail is shown only the rows the ordinary scan shows it.
--   v: a number as text, except on the rows deleted below ('junk')
--   w: a number as text when kind = 'n', a word otherwise
--   f: 7 on a clustered band of 301 rows, 1 elsewhere
--   x: 0 exactly where y = 0
CREATE TABLE gp_fail(a int, f int, kind text, v text, w text, x int, y int, c text)
  USING ao_column WITH (compresstype = zstd, compresslevel = 1) DISTRIBUTED BY (a);
INSERT INTO gp_fail
  SELECT i, CASE WHEN i BETWEEN 100000 AND 100300 THEN 7 ELSE 1 END,
         CASE WHEN i % 2 = 0 THEN 'n' ELSE 's' END,
         CASE WHEN i % 997 = 0 THEN 'junk' ELSE (i % 1000)::text END,
         CASE WHEN i % 2 = 0 THEN (i % 100)::text ELSE 'word' || i END,
         CASE WHEN i % 3 = 0 THEN 0 ELSE 1 + i % 5 END, i % 3,
         'payload ' || i
    FROM generate_series(1, 200000) i;
DELETE FROM gp_fail WHERE v = 'junk';
ANALYZE gp_fail;
-- Phase A consults the visimap before a clause that can fail: the deleted
-- rows are the ones the cast fails on.
SELECT gio_stages('SELECT c FROM gp_fail WHERE v::int = 5') AS cast_phase_a;
 cast_phase_a 
--------------
 v
(1 row)

SELECT gio_same('SELECT count(*) || '':'' || sum(a) FROM gp_fail WHERE v::int = 5') AS same_cast_phase_a;
 same_cast_phase_a 
-------------------
 t
(1 row)

-- f = 7 leads, but the cast stays behind kind = 'n', which the ordinary
-- scan evaluates first: the words in w never reach it.
SELECT gio_stages('SELECT c FROM gp_fail WHERE kind = ''n'' AND w::int = 5 AND f = 7') AS cast_after_guard;
 cast_after_guard 
------------------
 f, kind, w
(1 row)

SELECT gio_same('SELECT count(*) || '':'' || sum(a) FROM gp_fail WHERE kind = ''n'' AND w::int = 5 AND f = 7') AS same_cast_after_guard;
 same_cast_after_guard 
-----------------------
 t
(1 row)

-- An OR clause that can fail is not split across stages: its disjuncts are
-- evaluated left to right as the ordinary scan does, so 100 / x is never
-- reached on a row where y = 0 settles it (x = 0 there). x < 3 stages x
-- ahead of y; split, the division would be evaluated first.
SELECT gio_stages('SELECT c FROM gp_fail WHERE f = 7 AND x < 3 AND (y = 0 OR 100 / x > 30)') AS can_fail_or;
 can_fail_or 
-------------
 f, x, y
(1 row)

SELECT gio_same('SELECT count(*) || '':'' || sum(a) FROM gp_fail WHERE f = 7 AND x < 3 AND (y = 0 OR 100 / x > 30)') AS same_can_fail_or;
 same_can_fail_or 
------------------
 t
(1 row)

DROP TABLE gp_ord, gp_adapt, gp_win, gp_fail;
DROP FUNCTION gio_planned(text), gio_stages(text), gio_same(text),
              gio_arm(text, text), gio_hits(text), gio_reset(text),
              gio_plant(regclass, name, real[], real);
