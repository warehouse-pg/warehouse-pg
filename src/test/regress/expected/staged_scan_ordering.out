-- Staged Scan: how the Phase B stages are ordered and evaluated.
--
--   1. The planner derives its candidates from the predicate's structure:
--      every order of the AND-ed clauses is expanded into a column order
--      (an OR clause disjunct by disjunct) and costed; the first clause's
--      columns are Phase A.
--   2. The executor evaluates an OR clause one disjunct at a time and settles
--      the row as soon as one is true (the bypass), fetching the later
--      disjuncts' columns only for the rows that still need them.
--   3. After every window of survivors (4096, doubling) and at the end of
--      each segfile, the executor compares what each stage rejected against
--      what it cost and swaps adjacent stages the planner got in the wrong
--      order (adaptive ordering).
--
-- Same conventions as the other staged_scan tests: no CREATE SCHEMA /
-- search_path (hides gp_inject_fault()), no SQL wrapper functions over the
-- table (cannot be dispatched to a QE slice).
SET optimizer = off;
CREATE FUNCTION gio_planned(q text) RETURNS bool AS $BODY$
DECLARE line text;
BEGIN
    FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
        IF line LIKE '%Staged Seq Scan%' THEN
            RETURN true;
        END IF;
    END LOOP;
    RETURN false;
END $BODY$ LANGUAGE plpgsql;
CREATE FUNCTION gio_stages(q text) RETURNS text AS $BODY$
DECLARE line text;
BEGIN
    FOR line IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
        IF line LIKE '%Stages:%' THEN
            RETURN trim(substring(line from 'Stages: (.*)$'));
        END IF;
    END LOOP;
    RETURN '-';
END $BODY$ LANGUAGE plpgsql;
CREATE FUNCTION gio_same(q text) RETURNS bool AS $BODY$
DECLARE r_on text; r_off text;
BEGIN
    PERFORM set_config('whpg_enable_staged_scan', 'on', false);
    EXECUTE q INTO r_on;
    PERFORM set_config('whpg_enable_staged_scan', 'off', false);
    EXECUTE q INTO r_off;
    PERFORM set_config('whpg_enable_staged_scan', 'on', false);
    RETURN r_on IS NOT DISTINCT FROM r_off;
END $BODY$ LANGUAGE plpgsql;
CREATE FUNCTION gio_arm(faultname text, tab text) RETURNS bool AS $$
    SELECT bool_and(gp_inject_fault(faultname, 'skip', '', '', tab,
                                    1, -1, 0, dbid) = 'Success:')
      FROM gp_segment_configuration WHERE content > -1 AND role = 'p';
$$ LANGUAGE sql;
CREATE FUNCTION gio_hits(faultname text) RETURNS bigint AS $$
    SELECT sum(substring(gp_inject_fault(faultname, 'status', dbid)
                         from 'num times hit:''(\d+)''')::bigint)::bigint
      FROM gp_segment_configuration WHERE content > -1 AND role = 'p';
$$ LANGUAGE sql;
CREATE FUNCTION gio_reset(faultname text) RETURNS bool AS $$
    SELECT bool_and(gp_inject_fault(faultname, 'reset', dbid) = 'Success:')
      FROM gp_segment_configuration WHERE content > -1 AND role = 'p';
$$ LANGUAGE sql;
-- Plant statistics on an int column holding only 0 and 1: MCV {0,1} with the
-- given frequencies, and the given correlation. The planner reads the
-- coordinator's pg_statistic, so the coordinator's row is all it needs.
CREATE FUNCTION gio_plant(rel regclass, att name, freqs real[], corr real) RETURNS bool AS $$
    UPDATE pg_statistic
       SET stanullfrac = 0, stawidth = 4, stadistinct = 2,
           stakind1 = 1, staop1 = '=(int4,int4)'::regoperator, stacoll1 = 0,
           stanumbers1 = freqs, stavalues1 = '{0,1}'::int4[],
           stakind2 = 3, staop2 = '<(int4,int4)'::regoperator, stacoll2 = 0,
           stanumbers2 = ARRAY[corr], stavalues2 = NULL,
           stakind3 = 0, staop3 = 0, stacoll3 = 0, stanumbers3 = NULL, stavalues3 = NULL,
           stakind4 = 0, staop4 = 0, stacoll4 = 0, stanumbers4 = NULL, stavalues4 = NULL,
           stakind5 = 0, staop5 = 0, stacoll5 = 0, stanumbers5 = NULL, stavalues5 = NULL
     WHERE starelid = rel AND NOT stainherit
       AND staattnum = (SELECT attnum FROM pg_attribute
                         WHERE attrelid = rel AND attname = att)
    RETURNING true;
$$ LANGUAGE sql SET allow_system_table_mods = on;
-- f: a narrow clustered band of 301 rows (100000..100300).
-- s: 1 on nine rows in ten, 0 when i is a multiple of 10 -- a disjunct that
--    is usually true.
-- d, e: scattered over coprime moduli.
-- g: low-cardinality text, 'g5' on four rows.
CREATE TABLE gp_ord(a int, b bigint, c text, d int, e int, f int, s smallint, g text, pad text)
  USING ao_column WITH (compresstype = zstd, compresslevel = 1) DISTRIBUTED BY (a);
INSERT INTO gp_ord
  SELECT i, i * 2, 'payload ' || i,
         i % 1000, i % 997,
         CASE WHEN i BETWEEN 100000 AND 100300 THEN 7 ELSE 1 END,
         CASE WHEN i % 10 = 0 THEN 0 ELSE 1 END,
         'g' || (i % 50000),
         md5(i::text)
    FROM generate_series(1, 200000) i;
ANALYZE gp_ord;
--
-- ================= 1. Candidates from the predicate's structure =================
--
-- Within an OR clause decided in Phase B the disjunct most likely to settle a
-- row per unit of column cost goes first: s = 1 holds for 90% of the rows and
-- s is the narrowest column, so s is fetched before d.
EXPLAIN (COSTS OFF) SELECT c FROM gp_ord WHERE f = 7 AND (d = 5 OR s = 1);
                     QUERY PLAN                     
----------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Staged Seq Scan on gp_ord
         Filter: ((f = 7) AND ((d = 5) OR (s = 1)))
         Stages: f, s, d
 Optimizer: Postgres-based planner
(5 rows)

EXPLAIN (COSTS OFF) SELECT c FROM gp_ord WHERE f = 7 AND (s = 1 OR d = 5);
                     QUERY PLAN                     
----------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Staged Seq Scan on gp_ord
         Filter: ((f = 7) AND ((s = 1) OR (d = 5)))
         Stages: f, s, d
 Optimizer: Postgres-based planner
(5 rows)

-- Three clauses, five columns: f leads, and the four-row g = 'g5' is decided
-- before the OR, which is left with almost nothing to fetch. (d and e have
-- the same selectivity and width, so their order inside the OR is a tie and
-- is not pinned.)
SELECT gio_stages('SELECT c FROM gp_ord WHERE (d = 5 OR e = 5) AND f = 7 AND g = ''g5''') LIKE 'f, g, %' AS three_clauses_f_g_first;
 three_clauses_f_g_first 
-------------------------
 t
(1 row)

-- A column shared by two clauses is placed once, where the first clause that
-- needs it puts it: d < 100 is a plain clause on d, so d comes right after f
-- and e last; with two ORs sharing both columns only the leader is pinned.
SELECT gio_stages('SELECT c FROM gp_ord WHERE f = 7 AND (d = 5 OR e = 5) AND d < 100')       AS shared_col,
       gio_stages('SELECT c FROM gp_ord WHERE f = 7 AND (d = 5 OR e = 5) AND (e = 5 OR d = 6)') LIKE 'f, %' AS two_ors_f_leads;
 shared_col | two_ors_f_leads 
------------+-----------------
 f, d, e    | t
(1 row)

-- More clauses than the exhaustive enumeration takes (seven): the clauses
-- are tried in increasing selectivity order, and the plan is still made.
SELECT gio_planned('SELECT c FROM gp_ord WHERE f = 7 AND d = 5 AND e = 5 AND s = 1 AND g = ''g5'' AND a > 0 AND b > 0') AS seven_clauses,
       gio_stages('SELECT c FROM gp_ord WHERE f = 7 AND d = 5 AND e = 5 AND s = 1 AND g = ''g5'' AND a > 0 AND b > 0') LIKE 'f, %' AS seven_f_leads;
 seven_clauses | seven_f_leads 
---------------+---------------
 t             | f
(1 row)

--
-- ================= 2. The bypass, observed =================
--
-- f = 7 keeps 301 rows. Of those, 270 have s = 1 and are settled by the first
-- disjunct without fetching d (bypassed); the 31 with s = 0 fetch d, and none
-- of them has d = 5 (i = 100005 has s = 1), so all 31 are rejected.
SELECT gio_arm('StagedScan_PhaseA_Survivor', 'gp_ord'),
       gio_arm('StagedScan_Stage_Bypassed', 'gp_ord'),
       gio_arm('StagedScan_Stage_Rejected', 'gp_ord');
 gio_arm | gio_arm | gio_arm 
---------+---------+---------
 t       | t       | t
(1 row)

SELECT count(c) FROM gp_ord WHERE f = 7 AND (s = 1 OR d = 5);
 count 
-------
   270
(1 row)

SELECT gio_hits('StagedScan_PhaseA_Survivor') AS phase_a_survivors,
       gio_hits('StagedScan_Stage_Bypassed') AS bypassed,
       gio_hits('StagedScan_Stage_Rejected') AS rejected;
 phase_a_survivors | bypassed | rejected 
-------------------+----------+----------
               301 |      270 |       31
(1 row)

SELECT gio_reset('StagedScan_PhaseA_Survivor'),
       gio_reset('StagedScan_Stage_Bypassed'),
       gio_reset('StagedScan_Stage_Rejected');
 gio_reset | gio_reset | gio_reset 
-----------+-----------+-----------
 t         | t         | t
(1 row)

-- The fetch that the bypass saves. d = 5 holds on every thousandth row and
-- every one of them has s = 1, so the wide 'pad' column is never needed and
-- never fetched: the stages decompress blocks of d only, none of pad, and
-- the answer is the ordinary scan's (pad = 'x' is never true).
SELECT gio_arm('StagedScan_Stage_BlockDecompressed', 'gp_ord'),
       gio_arm('StagedScan_Stage_Bypassed', 'gp_ord');
 gio_arm | gio_arm 
---------+---------
 t       | t
(1 row)

SELECT count(c) FROM gp_ord WHERE d = 5 AND (s = 1 OR pad = 'x');
 count 
-------
   200
(1 row)

SELECT gio_hits('StagedScan_Stage_BlockDecompressed') AS blocks_decompressed,
       gio_hits('StagedScan_Stage_Bypassed') AS bypassed;
 blocks_decompressed | bypassed 
---------------------+----------
                  11 |      200
(1 row)

SELECT gio_reset('StagedScan_Stage_BlockDecompressed'),
       gio_reset('StagedScan_Stage_Bypassed');
 gio_reset | gio_reset 
-----------+-----------
 t         | t
(1 row)

SELECT gio_same('SELECT count(*) || '':'' || sum(b) FROM gp_ord WHERE d = 5 AND (s = 1 OR pad = ''x'')') AS unfetched_col_same;
 unfetched_col_same 
--------------------
 t
(1 row)

-- A disjunct whose column is projected is fetched for every row anyway: the
-- bypass only saves the evaluation, and the projected value is always there.
SELECT gio_same('SELECT count(*) || '':'' || sum(d) || '':'' || sum(s) FROM gp_ord WHERE f = 7 AND (s = 1 OR d = 5)') AS projected_disjunct_cols;
 projected_disjunct_cols 
-------------------------
 t
(1 row)

-- A column two clauses need -- one of them not an OR -- is never skipped.
SELECT gio_same('SELECT count(*) || '':'' || sum(b) FROM gp_ord WHERE f = 7 AND (s = 1 OR d = 5) AND d < 100') AS shared_with_and,
       gio_same('SELECT count(*) || '':'' || sum(b) FROM gp_ord WHERE f = 7 AND (s = 1 OR d = 5) AND (d = 5 OR e = 5)') AS shared_by_two_ors;
 shared_with_and | shared_by_two_ors 
-----------------+-------------------
 t               | t
(1 row)

-- Three disjuncts across three stages; the middle one settles some rows.
SELECT gio_same('SELECT count(*) || '':'' || sum(b) FROM gp_ord WHERE f = 7 AND (d = 5 OR s = 0 OR e = 5)') AS three_disjuncts,
       gio_same('SELECT count(*) || '':'' || sum(b) FROM gp_ord WHERE f = 7 AND (d = 100000 OR s = 0 OR e = 5)') AS three_disjuncts_first_dead;
 three_disjuncts | three_disjuncts_first_dead 
-----------------+----------------------------
 t               | t
(1 row)

--
-- ================= 3. Answers must not change =================
--
-- NULLs: a NULL disjunct never settles the clause; NULL OR true is kept,
-- NULL OR false is dropped.
INSERT INTO gp_ord VALUES (300001, 1, 'null-s',    5,    5, 7, NULL, 'g1', 'x'),
                          (300002, 2, 'null-d',    NULL, 5, 7, 0,    'g2', 'x'),
                          (300003, 3, 'null-both', NULL, 5, 7, NULL, 'g3', 'x'),
                          (300004, 4, 'keep-s',    NULL, 5, 7, 1,    'g4', 'x');
SELECT gio_same('SELECT count(*) || '':'' || string_agg(c, '','' ORDER BY a) FROM gp_ord WHERE f = 7 AND (s = 1 OR d = 5) AND a > 300000')        AS null_disjuncts,
       gio_same('SELECT count(*) || '':'' || string_agg(c, '','' ORDER BY a) FROM gp_ord WHERE f = 7 AND (s IS NULL OR d = 5) AND a > 300000')    AS is_null_disjunct,
       gio_same('SELECT count(*) || '':'' || string_agg(c, '','' ORDER BY a) FROM gp_ord WHERE f = 7 AND (s = 1 OR d IS NULL) AND a > 300000')    AS is_null_last;
 null_disjuncts | is_null_disjunct | is_null_last 
----------------+------------------+--------------
 t              | t                | t
(1 row)

SELECT c FROM gp_ord WHERE f = 7 AND (s = 1 OR d = 5) AND a > 300000 ORDER BY a;
   c    
--------
 null-s
 keep-s
(2 rows)

SELECT c FROM gp_ord WHERE f = 7 AND (s IS NULL OR d = 5) AND a > 300000 ORDER BY a;
     c     
-----------
 null-s
 null-both
(2 rows)

-- A Phase A column that several later clauses read is fetched at the first
-- stage that needs it, whatever order the clauses are written in. Here the
-- clause decided at the last stage (on e) comes first in the qual; the one
-- decided at the stage before it (on d) must still see f, which used to be
-- fetched only where the first clause in the qual wanted it -- too late.
SELECT gio_stages('SELECT c FROM gp_ord WHERE f = 7 AND e > f AND d < f') AS phase_a_col_two_stages;
 phase_a_col_two_stages 
------------------------
 f, d, e
(1 row)

SELECT gio_same('SELECT count(*) || '':'' || string_agg(c, '','' ORDER BY a) FROM gp_ord WHERE f = 7 AND e > f AND d < f') AS same_phase_a_col_two_stages;
 same_phase_a_col_two_stages 
-----------------------------
 t
(1 row)

