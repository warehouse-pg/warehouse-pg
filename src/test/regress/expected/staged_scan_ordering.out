(7 rows)

-- The same shape with clauses that can fail (integer addition overflows)
-- keeps their order: f + d = 12 is the more selective, but the ordinary
-- scan shows it only rows f + e >= 8 passed, and so does the Staged Scan.
SELECT gio_stages('SELECT c FROM gp_ord WHERE f = 7 AND f + e >= 8 AND f + d = 12') AS can_fail_keeps_order;
 can_fail_keeps_order 
----------------------
 f, e, d
(1 row)

SELECT gio_same('SELECT count(*) || '':'' || string_agg(c, '','' ORDER BY a) FROM gp_ord WHERE f = 7 AND f + e >= 8 AND f + d = 12') AS same_can_fail_keeps_order;
 same_can_fail_keeps_order 
---------------------------
 t
(1 row)

-- Deleted rows: a bypassed row is still a Phase A survivor, so the visimap
-- has already ruled on it.
DELETE FROM gp_ord WHERE c = 'keep-s';
SELECT gio_same('SELECT count(*) || '':'' || string_agg(c, '','' ORDER BY a) FROM gp_ord WHERE f = 7 AND (s = 1 OR d = 5) AND a > 300000') AS after_delete;
 after_delete 
--------------
 t
(1 row)

SELECT c FROM gp_ord WHERE f = 7 AND (s = 1 OR d = 5) AND a > 300000 ORDER BY a;
   c    
--------
