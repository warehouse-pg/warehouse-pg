--
-- ================= 5. Adaptive ordering inside one segfile =================
--
-- Most tables have a single segfile per segment, so learning at segfile
-- boundaries alone would rarely be applied. Windows of survivors fix that,
-- and let the order follow the data when it changes along the file.
--
-- One INSERT, hence one segfile per segment (~160k rows, ~16k survivors).
--   p: 1 on one row in ten (Phase A)
--   q: 1 on the first 70% of the rows (useless there), 0 on the last 30%
--      (rejects everything there)
--   r: 1 on one row in twenty -- rejects half of p's survivors, all along
--      the file (every multiple of 10 is a multiple of 20 or not, alternately)
CREATE TABLE gp_win(a int, p int, q int, r int, c text)
  USING ao_column WITH (compresstype = zstd, compresslevel = 1) DISTRIBUTED BY (a);
INSERT INTO gp_win
  SELECT i, CASE WHEN i % 10 = 0 THEN 1 ELSE 0 END,
         CASE WHEN i <= 336000 THEN 1 ELSE 0 END,
         CASE WHEN i % 20 = 0 THEN 1 ELSE 0 END, 'payload ' || i
    FROM generate_series(1, 480000) i;
ANALYZE gp_win;
SELECT segment_id, count(DISTINCT segno) AS segfiles
  FROM gp_toolkit.__gp_aocsseg('gp_win') WHERE tupcount > 0
 GROUP BY 1 ORDER BY 1;
 segment_id | segfiles 
------------+----------
          0 |        1
          1 |        1
          2 |        1
(3 rows)

-- Mislead the planner into p, q, r (planted: p = 1 at 0.1%, q = 1 at 2%,
-- both clustered; really 10% and 70%). The stages are re-scored after the
-- first 4096 survivors and then after the next 8192, which closes the second
-- window at survivor 12288, inside the first 70% of the ~16k survivors of a
-- segment; what is left is one partial window, in the final 30%.
-- Window 1: q rejects nothing, r half -> q and r swap to p, r, q.
-- Window 2 is still mostly in the first 70%: no change.
-- The last, partial window is entirely in the final 30%: q now rejects every
-- row that reaches it while r still rejects half -> they swap back to
-- p, q, r. Two reorders per segment, six in all; the answer is unchanged.
SELECT gio_plant('gp_win', 'p', '{0.999,0.001}', 0.9);
 gio_plant 
-----------
 t
(1 row)

SELECT gio_plant('gp_win', 'q', '{0.98,0.02}', 0.9);
 gio_plant 
-----------
 t
(1 row)

SELECT gio_stages('SELECT c FROM gp_win WHERE p = 1 AND q = 1 AND r = 1') AS misled_order;
 misled_order 
--------------
 p, q, r
(1 row)

SELECT gio_arm('StagedScan_Stage_Reordered', 'gp_win');
 gio_arm 
---------
 t
(1 row)

SELECT count(c) FROM gp_win WHERE p = 1 AND q = 1 AND r = 1;
 count 
-------
 16800
(1 row)

SELECT gio_hits('StagedScan_Stage_Reordered') AS reorders_windowed;
 reorders_windowed 
-------------------
                 6
(1 row)

SELECT gio_reset('StagedScan_Stage_Reordered');
 gio_reset 
-----------
 t
(1 row)

SELECT gio_same('SELECT count(*) || '':'' || sum(a) || '':'' || md5(string_agg(c, '','' ORDER BY a)) FROM gp_win WHERE p = 1 AND q = 1 AND r = 1') AS same_windowed;
 same_windowed 
