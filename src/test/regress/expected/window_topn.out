 0 |  4000 |  1
 0 |  6000 |  1
 0 |  8000 |  1
 0 | 10000 |  1
 0 | 12000 |  1
 0 | 14000 |  1
 0 | 16000 |  1
 0 | 18000 |  1
 0 | 20000 |  1
(10 rows)

--
-- distribution key equals the PARTITION BY column: no Motion is needed, so
-- the pre-filter is not used
--
create table wtp_d (p int, k int, v int) distributed by (p);
insert into wtp_d select * from wtp_t;
analyze wtp_d;
explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_d) s
where rk <= 3;
                   QUERY PLAN                   
------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.rk <= 3)
         ->  WindowAgg
               Partition By: wtp_d.p
               Order By: wtp_d.k
               ->  Sort
                     Sort Key: wtp_d.p, wtp_d.k
                     ->  Seq Scan on wtp_d
 Optimizer: Postgres-based planner
(10 rows)

--
-- other window functions in the same window clause are computed only by
-- the final WindowAgg, over the complete partition
--
explain (costs off)
select * from (
  select p, k, v,
         rank() over w as rk,
         sum(v) over w as sv,
         count(*) over (partition by p) as cp
  from wtp_t
  window w as (partition by p order by k)
) s where rk <= 2 order by p, k, v;
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: s.p, s.k, s.v
   ->  Sort
         Sort Key: s.p, s.k, s.v
         ->  Subquery Scan on s
               Filter: (s.rk <= 2)
               ->  WindowAgg
                     Partition By: wtp_t.p
                     ->  WindowAgg
                           Partition By: wtp_t.p
                           Order By: wtp_t.k
                           ->  Sort
                                 Sort Key: wtp_t.p, wtp_t.k
                                 ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                       Hash Key: wtp_t.p
                                       ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(17 rows)

