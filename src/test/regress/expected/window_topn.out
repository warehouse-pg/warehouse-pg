--
-- Window top-N pre-filter: a "rank() <= N" style filter of the outer query
-- is applied on each segment before the Motion of the window.
-- Planner-only feature (GUC whpg_enable_window_topn).
--
set optimizer = off;
create schema window_topn;
set search_path = window_topn;
-- distribution key differs from the PARTITION BY column, so the final
-- WindowAgg needs a Redistribute Motion
create table wtp_t (p int, k int, v int) distributed by (v);
insert into wtp_t select i % 5, (i * 7919) % 2000, i from generate_series(1, 20000) i;
analyze wtp_t;
-- a baseline computed without the optimization, for result comparisons
set whpg_enable_window_topn = off;
create table wtp_base_rank as
  select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
  where rk <= 3;
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column(s) named 'p' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
create table wtp_base_drank as
  select * from (select p, k, v, dense_rank() over (partition by p order by k) rk from wtp_t) s
  where rk < 3;
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column(s) named 'p' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
reset whpg_enable_window_topn;
--
-- rank() <= N: two WindowAgg nodes, the lower one with a Filter below the
-- Redistribute Motion
--
explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where rk <= 3;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.rk <= 3)
         ->  WindowAgg
               Partition By: wtp_t.p
               Order By: wtp_t.k
               ->  Sort
                     Sort Key: wtp_t.p, wtp_t.k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: wtp_t.p
                           ->  Result
                                 Filter: ((rank() OVER (?)) <= 3)
                                 ->  WindowAgg
                                       Partition By: wtp_t.p
                                       Order By: wtp_t.k
                                       ->  Sort
                                             Sort Key: wtp_t.p, wtp_t.k
                                             ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(19 rows)

select count(*),
       (select count(*) from wtp_base_rank) as expected
from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where rk <= 3;
 count | expected 
-------+----------
    50 |       50
(1 row)

select * from (
  (select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s where rk <= 3)
  except all
  (select * from wtp_base_rank)
) d;
 p | k | v | rk 
---+---+---+----
(0 rows)

select * from (
  (select * from wtp_base_rank)
  except all
  (select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s where rk <= 3)
) d;
 p | k | v | rk 
---+---+---+----
(0 rows)

--
-- dense_rank() < N, with ties
--
explain (costs off)
select * from (select p, k, v, dense_rank() over (partition by p order by k) rk from wtp_t) s
where rk < 3;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.rk < 3)
         ->  WindowAgg
               Partition By: wtp_t.p
               Order By: wtp_t.k
               ->  Sort
                     Sort Key: wtp_t.p, wtp_t.k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: wtp_t.p
                           ->  Result
                                 Filter: ((dense_rank() OVER (?)) < 3)
                                 ->  WindowAgg
                                       Partition By: wtp_t.p
                                       Order By: wtp_t.k
                                       ->  Sort
                                             Sort Key: wtp_t.p, wtp_t.k
                                             ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(19 rows)

select * from (
  (select * from (select p, k, v, dense_rank() over (partition by p order by k) rk from wtp_t) s where rk < 3)
  except all
  (select * from wtp_base_drank)
) d;
 p | k | v | rk 
---+---+---+----
(0 rows)

select * from (
  (select * from wtp_base_drank)
  except all
  (select * from (select p, k, v, dense_rank() over (partition by p order by k) rk from wtp_t) s where rk < 3)
) d;
 p | k | v | rk 
---+---+---+----
(0 rows)

--
-- row_number() with a unique ordering, so the result is deterministic
--
explain (costs off)
select * from (select p, k, v, row_number() over (partition by p order by k, v) rn from wtp_t) s
where rn <= 2 order by p, rn;
                                      QUERY PLAN                                       
---------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: s.p, s.rn
   ->  Sort
         Sort Key: s.p, s.rn
         ->  Subquery Scan on s
               Filter: (s.rn <= 2)
               ->  WindowAgg
                     Partition By: wtp_t.p
                     Order By: wtp_t.k, wtp_t.v
                     ->  Sort
                           Sort Key: wtp_t.p, wtp_t.k, wtp_t.v
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: wtp_t.p
                                 ->  Result
                                       Filter: ((row_number() OVER (?)) <= 2)
                                       ->  WindowAgg
                                             Partition By: wtp_t.p
                                             Order By: wtp_t.k, wtp_t.v
                                             ->  Sort
                                                   Sort Key: wtp_t.p, wtp_t.k, wtp_t.v
                                                   ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(22 rows)

select * from (select p, k, v, row_number() over (partition by p order by k, v) rn from wtp_t) s
where rn <= 2 order by p, rn;
 p | k |  v   | rn 
---+---+------+----
 0 | 0 | 2000 |  1
 0 | 0 | 4000 |  2
 1 | 4 |  716 |  1
 1 | 4 | 2716 |  2
 2 | 3 | 1037 |  1
 2 | 3 | 3037 |  2
 3 | 2 | 1358 |  1
 3 | 2 | 3358 |  2
 4 | 1 | 1679 |  1
 4 | 1 | 3679 |  2
(10 rows)

--
-- operator forms: constant on the left, bigint constant, equality
--
explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where 3 >= rk;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (3 >= s.rk)
         ->  WindowAgg
               Partition By: wtp_t.p
               Order By: wtp_t.k
               ->  Sort
                     Sort Key: wtp_t.p, wtp_t.k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: wtp_t.p
                           ->  Result
                                 Filter: ((rank() OVER (?)) <= 3)
                                 ->  WindowAgg
                                       Partition By: wtp_t.p
                                       Order By: wtp_t.k
                                       ->  Sort
                                             Sort Key: wtp_t.p, wtp_t.k
                                             ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(19 rows)

explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where rk <= 3::bigint;
                                 QUERY PLAN                                 
----------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.rk <= '3'::bigint)
