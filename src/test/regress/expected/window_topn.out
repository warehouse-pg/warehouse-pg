--
-- two subqueries with window functions in one query: the filter of one
-- must not leak into the other
--
explain (costs off)
select a.p, count(*), min(a.k) as min_k, max(b.k) as max_k
from (select p, k, rank() over (partition by p order by k) rk from wtp_t) a,
     (select p, k, rank() over (partition by p order by k desc) rk from wtp_t) b
where a.rk <= 1 and a.p = b.p and b.rk <= 1
group by a.p order by a.p;
                                               QUERY PLAN                                                
---------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: a.p
   ->  GroupAggregate
         Group Key: a.p
         ->  Sort
               Sort Key: a.p
               ->  Hash Join
                     Hash Cond: (a.p = b.p)
                     ->  Subquery Scan on a
                           Filter: (a.rk <= 1)
                           ->  WindowAgg
                                 Partition By: wtp_t.p
                                 Order By: wtp_t.k
                                 ->  Sort
                                       Sort Key: wtp_t.p, wtp_t.k
                                       ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                             Hash Key: wtp_t.p
                                             ->  Result
                                                   Filter: ((rank() OVER (?)) <= 1)
                                                   ->  WindowAgg
                                                         Partition By: wtp_t.p
                                                         Order By: wtp_t.k
                                                         ->  Sort
                                                               Sort Key: wtp_t.p, wtp_t.k
                                                               ->  Seq Scan on wtp_t
                     ->  Hash
                           ->  Subquery Scan on b
                                 Filter: (b.rk <= 1)
                                 ->  WindowAgg
                                       Partition By: wtp_t_1.p
                                       Order By: wtp_t_1.k
                                       ->  Sort
                                             Sort Key: wtp_t_1.p, wtp_t_1.k DESC
                                             ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                                   Hash Key: wtp_t_1.p
                                                   ->  Result
                                                         Filter: ((rank() OVER (?)) <= 1)
                                                         ->  WindowAgg
                                                               Partition By: wtp_t_1.p
                                                               Order By: wtp_t_1.k
                                                               ->  Sort
                                                                     Sort Key: wtp_t_1.p, wtp_t_1.k DESC
                                                                     ->  Seq Scan on wtp_t wtp_t_1
 Optimizer: Postgres-based planner
(44 rows)

select a.p, count(*), min(a.k) as min_k, max(b.k) as max_k
from (select p, k, rank() over (partition by p order by k) rk from wtp_t) a,
     (select p, k, rank() over (partition by p order by k desc) rk from wtp_t) b
where a.rk <= 1 and a.p = b.p and b.rk <= 1
group by a.p order by a.p;
 p | count | min_k | max_k 
---+-------+-------+-------
 0 |   100 |     0 |  1995
 1 |   100 |     4 |  1999
 2 |   100 |     3 |  1998
 3 |   100 |     2 |  1997
 4 |   100 |     1 |  1996
(5 rows)

--
-- GUC off: a single WindowAgg
--
set whpg_enable_window_topn = off;
explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where rk <= 3;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.rk <= 3)
         ->  WindowAgg
               Partition By: wtp_t.p
               Order By: wtp_t.k
               ->  Sort
                     Sort Key: wtp_t.p, wtp_t.k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: wtp_t.p
                           ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(12 rows)

reset whpg_enable_window_topn;
drop schema window_topn cascade;
NOTICE:  drop cascades to 4 other objects
DETAIL:  drop cascades to table wtp_t
drop cascades to table wtp_base_rank
drop cascades to table wtp_base_drank
drop cascades to table wtp_d
