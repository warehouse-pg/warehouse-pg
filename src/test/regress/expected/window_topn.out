reset whpg_enable_window_topn;
--
-- two filtered window functions of the same window clause: both are
-- computed by the first stage, the Filter has both conditions
--
explain (costs off)
select * from (
  select p, k, v,
         rank() over w as rk,
         dense_rank() over w as dr
  from wtp_t
  window w as (partition by p order by k)
) s where rk <= 3 and dr <= 2 order by p, k, v;
                                                 QUERY PLAN                                                  
-------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: s.p, s.k, s.v
   ->  Sort
         Sort Key: s.p, s.k, s.v
         ->  Subquery Scan on s
               Filter: ((s.rk <= 3) AND (s.dr <= 2))
               ->  WindowAgg
                     Partition By: wtp_t.p
                     Order By: wtp_t.k
                     ->  Sort
                           Sort Key: wtp_t.p, wtp_t.k
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: wtp_t.p
                                 ->  Result
                                       Filter: (((rank() OVER (?)) <= 3) AND ((dense_rank() OVER (?)) <= 2))
                                       ->  WindowAgg
                                             Partition By: wtp_t.p
                                             Order By: wtp_t.k
                                             ->  Sort
                                                   Sort Key: wtp_t.p, wtp_t.k
                                                   ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(22 rows)

select * from (
  select p, k, v,
         rank() over w as rk,
         dense_rank() over w as dr
  from wtp_t
  window w as (partition by p order by k)
) s where rk <= 3 and dr <= 2 order by p, k, v;
 p | k |   v   | rk | dr 
---+---+-------+----+----
 0 | 0 |  2000 |  1 |  1
 0 | 0 |  4000 |  1 |  1
 0 | 0 |  6000 |  1 |  1
