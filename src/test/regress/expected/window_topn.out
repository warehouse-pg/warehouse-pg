--
-- Window top-N pre-filter: a "rank() <= N" style filter of the outer query
-- is applied on each segment before the window's Sort and Motion, by a
-- WindowTopN node or, where the node does not apply, by Sort + WindowAgg +
-- Filter (GUC whpg_enable_window_topn).  See window_topn_orca for the ORCA
-- optimizer.
--
set optimizer = off;
create schema window_topn;
set search_path = window_topn;
-- distribution key differs from the PARTITION BY column, so the final
-- WindowAgg needs a Redistribute Motion
create table wtp_t (p int, k int, v int) distributed by (v);
insert into wtp_t select i % 5, (i * 7919) % 2000, i from generate_series(1, 20000) i;
analyze wtp_t;
-- a baseline computed without the optimization, for result comparisons
set whpg_enable_window_topn = off;
create table wtp_base_rank as
  select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
  where rk <= 3;
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column(s) named 'p' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
create table wtp_base_drank as
  select * from (select p, k, v, dense_rank() over (partition by p order by k) rk from wtp_t) s
  where rk < 3;
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column(s) named 'p' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
reset whpg_enable_window_topn;
--
-- rank() <= N: a first stage below the Redistribute Motion keeps each
-- segment's candidate rows
--
explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where rk <= 3;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.rk <= 3)
         ->  WindowAgg
               Partition By: wtp_t.p
               Order By: wtp_t.k
               ->  Sort
                     Sort Key: wtp_t.p, wtp_t.k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: wtp_t.p
                           ->  WindowTopN
                                 Partition By: wtp_t.p
                                 Order By: wtp_t.k
                                 Top N: rank() <= 3
                                 ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(16 rows)

select count(*),
       (select count(*) from wtp_base_rank) as expected
from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where rk <= 3;
 count | expected 
-------+----------
    50 |       50
(1 row)

select * from (
  (select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s where rk <= 3)
  except all
  (select * from wtp_base_rank)
) d;
 p | k | v | rk 
---+---+---+----
(0 rows)

select * from (
  (select * from wtp_base_rank)
  except all
  (select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s where rk <= 3)
) d;
 p | k | v | rk 
---+---+---+----
(0 rows)

--
-- dense_rank() < N, with ties
--
explain (costs off)
select * from (select p, k, v, dense_rank() over (partition by p order by k) rk from wtp_t) s
where rk < 3;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.rk < 3)
         ->  WindowAgg
               Partition By: wtp_t.p
               Order By: wtp_t.k
               ->  Sort
                     Sort Key: wtp_t.p, wtp_t.k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: wtp_t.p
                           ->  WindowTopN
                                 Partition By: wtp_t.p
                                 Order By: wtp_t.k
                                 Top N: dense_rank() < 3
                                 ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(16 rows)

select * from (
  (select * from (select p, k, v, dense_rank() over (partition by p order by k) rk from wtp_t) s where rk < 3)
  except all
  (select * from wtp_base_drank)
) d;
 p | k | v | rk 
---+---+---+----
(0 rows)

select * from (
  (select * from wtp_base_drank)
  except all
  (select * from (select p, k, v, dense_rank() over (partition by p order by k) rk from wtp_t) s where rk < 3)
) d;
 p | k | v | rk 
---+---+---+----
(0 rows)

--
-- row_number() with a unique ordering, so the result is deterministic
--
explain (costs off)
select * from (select p, k, v, row_number() over (partition by p order by k, v) rn from wtp_t) s
where rn <= 2 order by p, rn;
                                  QUERY PLAN                                  
------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: s.p, s.rn
   ->  Sort
         Sort Key: s.p, s.rn
         ->  Subquery Scan on s
               Filter: (s.rn <= 2)
               ->  WindowAgg
                     Partition By: wtp_t.p
                     Order By: wtp_t.k, wtp_t.v
                     ->  Sort
                           Sort Key: wtp_t.p, wtp_t.k, wtp_t.v
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: wtp_t.p
                                 ->  WindowTopN
                                       Partition By: wtp_t.p
                                       Order By: wtp_t.k, wtp_t.v
                                       Top N: row_number() <= 2
                                       ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(19 rows)

select * from (select p, k, v, row_number() over (partition by p order by k, v) rn from wtp_t) s
where rn <= 2 order by p, rn;
 p | k |  v   | rn 
---+---+------+----
 0 | 0 | 2000 |  1
 0 | 0 | 4000 |  2
 1 | 4 |  716 |  1
 1 | 4 | 2716 |  2
 2 | 3 | 1037 |  1
 2 | 3 | 3037 |  2
 3 | 2 | 1358 |  1
 3 | 2 | 3358 |  2
 4 | 1 | 1679 |  1
 4 | 1 | 3679 |  2
(10 rows)

--
-- operator forms: constant on the left, bigint constant, equality
--
explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where 3 >= rk;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (3 >= s.rk)
         ->  WindowAgg
               Partition By: wtp_t.p
               Order By: wtp_t.k
               ->  Sort
                     Sort Key: wtp_t.p, wtp_t.k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: wtp_t.p
                           ->  WindowTopN
                                 Partition By: wtp_t.p
                                 Order By: wtp_t.k
                                 Top N: rank() <= 3
                                 ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(16 rows)

explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where rk <= 3::bigint;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.rk <= '3'::bigint)
         ->  WindowAgg
               Partition By: wtp_t.p
               Order By: wtp_t.k
               ->  Sort
                     Sort Key: wtp_t.p, wtp_t.k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: wtp_t.p
                           ->  WindowTopN
                                 Partition By: wtp_t.p
                                 Order By: wtp_t.k
                                 Top N: rank() <= '3'::bigint
                                 ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(16 rows)

explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where rk = 1;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.rk = 1)
         ->  WindowAgg
               Partition By: wtp_t.p
               Order By: wtp_t.k
               ->  Sort
                     Sort Key: wtp_t.p, wtp_t.k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: wtp_t.p
                           ->  WindowTopN
                                 Partition By: wtp_t.p
                                 Order By: wtp_t.k
                                 Top N: rank() <= 1
                                 ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(16 rows)

select p, k, count(*) from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where rk = 1 group by p, k order by p;
 p | k | count 
---+---+-------
 0 | 0 |    10
 1 | 4 |    10
 2 | 3 |    10
 3 | 2 |    10
 4 | 1 |    10
(5 rows)

-- a PREPARE parameter is a valid bound too
prepare wtp_p(int) as
select p, count(*) from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where rk <= $1 group by p order by p;
explain (costs off) execute wtp_p(3);
                                  QUERY PLAN                                  
------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: s.p
   ->  GroupAggregate
         Group Key: s.p
         ->  Subquery Scan on s
               Filter: (s.rk <= 3)
               ->  WindowAgg
                     Partition By: wtp_t.p
                     Order By: wtp_t.k
                     ->  Sort
                           Sort Key: wtp_t.p, wtp_t.k
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: wtp_t.p
                                 ->  WindowTopN
                                       Partition By: wtp_t.p
                                       Order By: wtp_t.k
                                       Top N: rank() <= 3
                                       ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(19 rows)

execute wtp_p(3);
 p | count 
---+-------
 0 |    10
 1 |    10
 2 |    10
 3 |    10
 4 |    10
(5 rows)

deallocate wtp_p;
--
-- not eligible: ">" filter, non-monotonic function, LIMIT in the subquery
--
explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where rk > 3;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.rk > 3)
         ->  WindowAgg
               Partition By: wtp_t.p
               Order By: wtp_t.k
               ->  Sort
                     Sort Key: wtp_t.p, wtp_t.k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: wtp_t.p
                           ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(12 rows)

explain (costs off)
select * from (select p, k, v, percent_rank() over (partition by p order by k) pr from wtp_t) s
where pr <= 0.1;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.pr <= '0.1'::double precision)
         ->  WindowAgg
               Partition By: wtp_t.p
               Order By: wtp_t.k
               ->  Sort
                     Sort Key: wtp_t.p, wtp_t.k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: wtp_t.p
                           ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(12 rows)

explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t limit 100) s
where rk <= 3;
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Subquery Scan on s
   Filter: (s.rk <= 3)
   ->  Limit
         ->  Gather Motion 3:1  (slice1; segments: 3)
               Merge Key: wtp_t.p, wtp_t.k
               ->  Limit
                     ->  WindowAgg
                           Partition By: wtp_t.p
                           Order By: wtp_t.k
                           ->  Sort
                                 Sort Key: wtp_t.p, wtp_t.k
                                 ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                       Hash Key: wtp_t.p
                                       ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(15 rows)

--
-- no PARTITION BY: the final WindowAgg gathers to a single segment; the
-- pre-filtered input stays sorted and is merged by the Gather Motion
--
explain (costs off)
select * from (select k, v, rank() over (order by k) rk from wtp_t) s
where rk <= 3 order by k, v;
                         QUERY PLAN                         
------------------------------------------------------------
 Sort
   Sort Key: s.k, s.v
   ->  Subquery Scan on s
         Filter: (s.rk <= 3)
         ->  WindowAgg
               Order By: wtp_t.k
               ->  Gather Motion 3:1  (slice1; segments: 3)
                     Merge Key: wtp_t.k
                     ->  Sort
                           Sort Key: wtp_t.k
                           ->  WindowTopN
                                 Order By: wtp_t.k
                                 Top N: rank() <= 3
                                 ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(15 rows)

select * from (select k, v, rank() over (order by k) rk from wtp_t) s
where rk <= 3 order by k, v;
 k |   v   | rk 
---+-------+----
 0 |  2000 |  1
 0 |  4000 |  1
 0 |  6000 |  1
 0 |  8000 |  1
 0 | 10000 |  1
 0 | 12000 |  1
 0 | 14000 |  1
 0 | 16000 |  1
 0 | 18000 |  1
 0 | 20000 |  1
(10 rows)

--
-- distribution key equals the PARTITION BY column: no Motion is needed.
-- The Sort form of the first stage would only repeat the final stage, but
-- WindowTopN still pays off: the final WindowAgg sorts the kept rows
-- instead of the whole input
--
create table wtp_d (p int, k int, v int) distributed by (p);
insert into wtp_d select * from wtp_t;
analyze wtp_d;
explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_d) s
where rk <= 3;
                   QUERY PLAN                    
-------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.rk <= 3)
         ->  WindowAgg
               Partition By: wtp_d.p
               Order By: wtp_d.k
               ->  Sort
                     Sort Key: wtp_d.p, wtp_d.k
                     ->  WindowTopN
                           Partition By: wtp_d.p
                           Order By: wtp_d.k
                           Top N: rank() <= 3
                           ->  Seq Scan on wtp_d
 Optimizer: Postgres-based planner
(14 rows)

select count(*), (select count(*) from wtp_base_rank) as expected from (
  (select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_d) s where rk <= 3)
  intersect all
  (select * from wtp_base_rank)
) d;
 count | expected 
-------+----------
    50 |       50
(1 row)

-- without WindowTopN there is no first stage
set whpg_enable_window_topn = off;
explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_d) s
where rk <= 3;
                   QUERY PLAN                   
------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.rk <= 3)
         ->  WindowAgg
               Partition By: wtp_d.p
               Order By: wtp_d.k
               ->  Sort
                     Sort Key: wtp_d.p, wtp_d.k
                     ->  Seq Scan on wtp_d
 Optimizer: Postgres-based planner
(10 rows)

reset whpg_enable_window_topn;
-- the same when the input is already on a single segment (the LIMIT
-- gathers it there)
explain (costs off)
select * from (
  select p, k, v, rank() over (partition by p order by k) rk
  from (select p, k, v from wtp_t limit 100000) i
) s where rk <= 3;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Subquery Scan on s
   Filter: (s.rk <= 3)
   ->  WindowAgg
         Partition By: wtp_t.p
         Order By: wtp_t.k
         ->  Sort
               Sort Key: wtp_t.p, wtp_t.k
               ->  WindowTopN
                     Partition By: wtp_t.p
                     Order By: wtp_t.k
                     Top N: rank() <= 3
                     ->  Limit
                           ->  Gather Motion 3:1  (slice1; segments: 3)
                                 ->  Limit
                                       ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(16 rows)

select count(*), (select count(*) from wtp_base_rank) as expected from (
  (select * from (
     select p, k, v, rank() over (partition by p order by k) rk
     from (select p, k, v from wtp_t limit 100000) i
   ) s where rk <= 3)
  intersect all
  (select * from wtp_base_rank)
) d;
 count | expected 
-------+----------
    50 |       50
(1 row)

--
-- other window functions in the same window clause are computed only by
-- the final WindowAgg, over the complete partition
--
explain (costs off)
select * from (
  select p, k, v,
         rank() over w as rk,
         sum(v) over w as sv,
         count(*) over (partition by p) as cp
  from wtp_t
  window w as (partition by p order by k)
) s where rk <= 2 order by p, k, v;
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: s.p, s.k, s.v
   ->  Sort
         Sort Key: s.p, s.k, s.v
         ->  Subquery Scan on s
               Filter: (s.rk <= 2)
               ->  WindowAgg
                     Partition By: wtp_t.p
                     ->  WindowAgg
                           Partition By: wtp_t.p
                           Order By: wtp_t.k
                           ->  Sort
                                 Sort Key: wtp_t.p, wtp_t.k
                                 ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                       Hash Key: wtp_t.p
                                       ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(17 rows)

select * from (
  select p, k, v,
         rank() over w as rk,
         sum(v) over w as sv,
         count(*) over (partition by p) as cp
  from wtp_t
  window w as (partition by p order by k)
) s where rk <= 2 order by p, k, v;
