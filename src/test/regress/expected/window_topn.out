--
-- filtered window functions of two different window clauses: the Motion
-- is added for the first window; the second one, the topmost, finds its
-- input already distributed by the partitioning column and still gets a
-- WindowTopN in front of its WindowAgg
--
explain (costs off)
select * from (
  select p, k, v,
         rank() over (partition by p order by k) rk,
         row_number() over (partition by p order by k, v) rn
  from wtp_t
) s where rk <= 3 and rn <= 2 order by p, k, v;
                                           QUERY PLAN                                           
------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: s.p, s.k, s.v
   ->  Sort
         Sort Key: s.p, s.k, s.v
         ->  Subquery Scan on s
               Filter: ((s.rk <= 3) AND (s.rn <= 2))
               ->  WindowAgg
                     Partition By: wtp_t.p
                     Order By: wtp_t.k
                     ->  Sort
                           Sort Key: wtp_t.p, wtp_t.k
                           ->  WindowTopN
                                 Partition By: wtp_t.p
                                 Order By: wtp_t.k
                                 Top N: rank() <= 3
                                 ->  WindowAgg
                                       Partition By: wtp_t.p
                                       Order By: wtp_t.k, wtp_t.v
                                       ->  Sort
                                             Sort Key: wtp_t.p, wtp_t.k, wtp_t.v
                                             ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                                   Hash Key: wtp_t.p
                                                   ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(24 rows)

