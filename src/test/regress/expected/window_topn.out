-- a PREPARE parameter is a valid bound too
prepare wtp_p(int) as
select p, count(*) from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where rk <= $1 group by p order by p;
explain (costs off) execute wtp_p(3);
                                  QUERY PLAN                                  
------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: s.p
   ->  GroupAggregate
         Group Key: s.p
         ->  Subquery Scan on s
               Filter: (s.rk <= 3)
               ->  WindowAgg
                     Partition By: wtp_t.p
                     Order By: wtp_t.k
                     ->  Sort
                           Sort Key: wtp_t.p, wtp_t.k
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: wtp_t.p
                                 ->  Result
                                       Filter: ((rank() OVER (?)) <= 3)
                                       ->  WindowAgg
                                             Partition By: wtp_t.p
                                             Order By: wtp_t.k
                                             ->  Sort
                                                   Sort Key: wtp_t.p, wtp_t.k
                                                   ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(22 rows)

execute wtp_p(3);
 p | count 
---+-------
 0 |    10
 1 |    10
 2 |    10
 3 |    10
 4 |    10
(5 rows)

deallocate wtp_p;
--
-- not eligible: ">" filter, non-monotonic function, LIMIT in the subquery
--
explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t) s
where rk > 3;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.rk > 3)
         ->  WindowAgg
               Partition By: wtp_t.p
               Order By: wtp_t.k
               ->  Sort
                     Sort Key: wtp_t.p, wtp_t.k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: wtp_t.p
                           ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(12 rows)

explain (costs off)
select * from (select p, k, v, percent_rank() over (partition by p order by k) pr from wtp_t) s
where pr <= 0.1;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Subquery Scan on s
         Filter: (s.pr <= '0.1'::double precision)
         ->  WindowAgg
               Partition By: wtp_t.p
               Order By: wtp_t.k
               ->  Sort
                     Sort Key: wtp_t.p, wtp_t.k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: wtp_t.p
                           ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(12 rows)

explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wtp_t limit 100) s
where rk <= 3;
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Subquery Scan on s
   Filter: (s.rk <= 3)
   ->  Limit
         ->  Gather Motion 3:1  (slice1; segments: 3)
               Merge Key: wtp_t.p, wtp_t.k
               ->  Limit
                     ->  WindowAgg
                           Partition By: wtp_t.p
                           Order By: wtp_t.k
                           ->  Sort
                                 Sort Key: wtp_t.p, wtp_t.k
                                 ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                       Hash Key: wtp_t.p
                                       ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(15 rows)

--
-- no PARTITION BY: the final WindowAgg gathers to a single segment; the
-- pre-filtered input stays sorted and is merged by the Gather Motion
--
explain (costs off)
select * from (select k, v, rank() over (order by k) rk from wtp_t) s
where rk <= 3 order by k, v;
                         QUERY PLAN                          
-------------------------------------------------------------
 Sort
   Sort Key: s.k, s.v
   ->  Subquery Scan on s
         Filter: (s.rk <= 3)
         ->  WindowAgg
               Order By: wtp_t.k
               ->  Gather Motion 3:1  (slice1; segments: 3)
                     Merge Key: wtp_t.k
                     ->  Result
                           Filter: ((rank() OVER (?)) <= 3)
                           ->  WindowAgg
                                 Order By: wtp_t.k
                                 ->  Sort
                                       Sort Key: wtp_t.k
                                       ->  Seq Scan on wtp_t
 Optimizer: Postgres-based planner
(16 rows)

select * from (select k, v, rank() over (order by k) rk from wtp_t) s
where rk <= 3 order by k, v;
 k |   v   | rk 
