--
-- a shared CTE below the window: its Share Input Scan runs in the slice of
-- the first stage
--
set gp_cte_sharing = on;
explain (costs off)
with c as (select p, k, v from wtp_t)
select p, k, v, rk from (select p, k, v, rank() over (partition by p order by k) rk from c) s
where rk <= 2
union all
select -1, count(*)::int, null, null from c
order by 1, 2, 3;
                                     QUERY PLAN                                     
------------------------------------------------------------------------------------
 Sort
   Sort Key: s.p, s.k, s.v
   ->  Merge Append
         Sort Key: s.p
         ->  Gather Motion 3:1  (slice1; segments: 3)
               Merge Key: s.p
               ->  Subquery Scan on s
                     Filter: (s.rk <= 2)
                     ->  WindowAgg
                           Partition By: share0_ref1.p
                           Order By: share0_ref1.k
                           ->  Sort
                                 Sort Key: share0_ref1.p, share0_ref1.k
                                 ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                       Hash Key: share0_ref1.p
                                       ->  WindowTopN
                                             Partition By: share0_ref1.p
                                             Order By: share0_ref1.k
                                             Top N: rank() <= 2
                                             ->  Shared Scan (share slice:id 2:0)
                                                   ->  Seq Scan on wtp_t
         ->  Sort
               Sort Key: ('-1'::integer)
               ->  Finalize Aggregate
                     ->  Gather Motion 3:1  (slice3; segments: 3)
                           ->  Partial Aggregate
                                 ->  Shared Scan (share slice:id 3:0)
 Optimizer: Postgres-based planner
(28 rows)

