create table wto_d (p int, k int, v int) distributed by (p);
insert into wto_d select * from wto_t;
analyze wto_d;
explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wto_d) s
where rk <= 3;
                QUERY PLAN                 
-------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Result
         Filter: ((rank() OVER (?)) <= 3)
         ->  WindowAgg
               Partition By: p
               Order By: k
               ->  Sort
                     Sort Key: p, k
                     ->  Seq Scan on wto_d
 Optimizer: GPORCA
(10 rows)

--
-- the input of the first stage may hold Share Input Scans, as a ROLLUP does
-- with this optimizer: they run in the slice of the WindowTopN
--
explain (costs off)
select * from (
  select p, k, sum(v) as s, rank() over (partition by p order by sum(v) desc) rk
  from wto_t group by rollup (p, k)
) s where rk <= 2 order by p, k;
                                                      QUERY PLAN                                                      
----------------------------------------------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: share0_ref2.p, share0_ref2.k
   ->  Sort
         Sort Key: share0_ref2.p, share0_ref2.k
         ->  Result
               Filter: ((rank() OVER (?)) <= 2)
               ->  WindowAgg
                     Partition By: share0_ref2.p
                     Order By: (sum(share0_ref2.v))
                     ->  Sort
                           Sort Key: share0_ref2.p, (sum(share0_ref2.v)) DESC
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: share0_ref2.p
                                 ->  WindowTopN
                                       Partition By: share0_ref2.p
                                       Order By: (sum(share0_ref2.v)) DESC
                                       Top N: rank() <= 2
                                       ->  Sequence
                                             ->  Shared Scan (share slice:id 2:0)
                                                   ->  Seq Scan on wto_t
                                             ->  Append
                                                   ->  HashAggregate
                                                         Group Key: share0_ref2.p, share0_ref2.k
                                                         ->  Redistribute Motion 3:3  (slice3; segments: 3)
                                                               Hash Key: share0_ref2.p, share0_ref2.k
                                                               ->  Shared Scan (share slice:id 3:0)
                                                   ->  Finalize GroupAggregate
                                                         Group Key: share0_ref3.p
                                                         ->  Sort
                                                               Sort Key: share0_ref3.p
                                                               ->  Redistribute Motion 3:3  (slice4; segments: 3)
                                                                     Hash Key: share0_ref3.p
                                                                     ->  Streaming Partial HashAggregate
                                                                           Group Key: share0_ref3.p
                                                                           ->  Shared Scan (share slice:id 4:0)
                                                   ->  Result
                                                         ->  Redistribute Motion 1:3  (slice5)
                                                               ->  Finalize Aggregate
                                                                     ->  Gather Motion 3:1  (slice6; segments: 3)
                                                                           ->  Partial Aggregate
                                                                                 ->  Shared Scan (share slice:id 6:0)
 Optimizer: GPORCA
(42 rows)

select * from (
  select p, k, sum(v) as s, rank() over (partition by p order by sum(v) desc) rk
  from wto_t group by rollup (p, k)
) s where rk <= 2 order by p, k;
 p |  k  |     s     | rk 
---+-----+-----------+----
 0 |   0 |    110000 |  2
 0 |     |  40010000 |  1
 1 | 324 |    109960 |  2
 1 |     |  39994000 |  1
 2 | 243 |    109970 |  2
 2 |     |  39998000 |  1
 3 | 162 |    109980 |  2
 3 |     |  40002000 |  1
 4 |  81 |    109990 |  2
 4 |     |  40006000 |  1
   |     | 200010000 |  1
(11 rows)

--
-- GUC off
--
set whpg_enable_window_topn = off;
explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wto_t) s
where rk <= 3;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Result
         Filter: ((rank() OVER (?)) <= 3)
         ->  WindowAgg
               Partition By: p
               Order By: k
               ->  Sort
                     Sort Key: p, k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: p
                           ->  Seq Scan on wto_t
 Optimizer: GPORCA
(12 rows)

reset whpg_enable_window_topn;
drop schema window_topn_orca cascade;
NOTICE:  drop cascades to 4 other objects
DETAIL:  drop cascades to table wto_t
drop cascades to table wto_base_rank
drop cascades to table wto_base_drank
drop cascades to table wto_d
