explain (costs off)
select * from (
  select p, k, v, rank() over w as rk, sum(v) over w as total
  from wto_t window w as (partition by p order by k
                          rows between unbounded preceding and unbounded following)
) s where rk <= 2;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Result
         Filter: ((rank() OVER (?)) <= 2)
         ->  WindowAgg
               Partition By: p
               Order By: k
               ->  Sort
                     Sort Key: p, k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: p
                           ->  Seq Scan on wto_t
 Optimizer: GPORCA
(12 rows)

explain (costs off)
select * from (
  select p, k, v, row_number() over w as rn, sum(v) over w as running
  from wto_t window w as (partition by p order by k, v)
) s where rn <= 2;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Result
         Filter: ((row_number() OVER (?)) <= 2)
         ->  WindowAgg
               Partition By: p
               Order By: k, v
               ->  Sort
                     Sort Key: p, k, v
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: p
                           ->  Seq Scan on wto_t
 Optimizer: GPORCA
(12 rows)

explain (costs off)
select * from (
  select p, k, v, row_number() over w as rn, sum(v) over w as running
  from wto_t window w as (partition by p order by k, v
                          rows between unbounded preceding and current row)
) s where rn <= 2 order by p, k, v;
                                  QUERY PLAN                                  
------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: p, k, v
   ->  Sort
         Sort Key: p, k, v
         ->  Result
               Filter: ((row_number() OVER (?)) <= 2)
               ->  WindowAgg
                     Partition By: p
                     Order By: k, v
                     ->  Sort
                           Sort Key: p, k, v
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: p
                                 ->  WindowTopN
                                       Partition By: p
                                       Order By: k, v
                                       Top N: row_number() <= 2
                                       ->  Seq Scan on wto_t
 Optimizer: GPORCA
(19 rows)

