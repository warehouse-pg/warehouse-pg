--
-- Window top-N pre-filter with the ORCA optimizer: a "rank() <= N" style
-- filter of the outer query becomes a WindowTopN node below the window's
-- Motion (see window_topn for the planner).
--
set optimizer = on;
set optimizer_trace_fallback = on;
create schema window_topn_orca;
set search_path = window_topn_orca;
create table wto_t (p int, k int, v int) distributed by (v);
insert into wto_t select i % 5, (i * 7919) % 2000, i from generate_series(1, 20000) i;
analyze wto_t;
-- baselines without the optimization
set whpg_enable_window_topn = off;
create table wto_base_rank as
  select * from (select p, k, v, rank() over (partition by p order by k) rk from wto_t) s
  where rk <= 3;
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause. Creating a NULL policy entry.
create table wto_base_drank as
  select * from (select p, k, v, dense_rank() over (partition by p order by k desc) dr from wto_t) s
  where dr < 3;
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause. Creating a NULL policy entry.
reset whpg_enable_window_topn;
--
-- rank() <= N
--
explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wto_t) s
where rk <= 3;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Result
         Filter: ((rank() OVER (?)) <= 3)
         ->  WindowAgg
               Partition By: p
               Order By: k
               ->  Sort
                     Sort Key: p, k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: p
                           ->  WindowTopN
                                 Partition By: p
                                 Order By: k
                                 Top N: rank() <= 3
                                 ->  Seq Scan on wto_t
 Optimizer: GPORCA
(16 rows)

select count(*), (select count(*) from wto_base_rank) as expected from (
  (select * from (select p, k, v, rank() over (partition by p order by k) rk from wto_t) s where rk <= 3)
  intersect all
  (select * from wto_base_rank)
) d;
 count | expected 
-------+----------
    50 |       50
(1 row)

--
-- dense_rank() < N, constant on the left, equality
--
explain (costs off)
select * from (select p, k, v, dense_rank() over (partition by p order by k desc) dr from wto_t) s
where 3 > dr;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Result
         Filter: ((dense_rank() OVER (?)) < 3)
         ->  WindowAgg
               Partition By: p
               Order By: k
               ->  Sort
                     Sort Key: p, k DESC
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: p
                           ->  WindowTopN
                                 Partition By: p
                                 Order By: k DESC
                                 Top N: dense_rank() <= 2
                                 ->  Seq Scan on wto_t
 Optimizer: GPORCA
(16 rows)

select count(*), (select count(*) from wto_base_drank) as expected from (
  (select * from (select p, k, v, dense_rank() over (partition by p order by k desc) dr from wto_t) s where 3 > dr)
  intersect all
  (select * from wto_base_drank)
) d;
 count | expected 
-------+----------
   100 |      100
(1 row)

explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wto_t) s
where rk = 1;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Result
         Filter: ((rank() OVER (?)) = 1)
         ->  WindowAgg
               Partition By: p
               Order By: k
               ->  Sort
                     Sort Key: p, k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: p
                           ->  WindowTopN
                                 Partition By: p
                                 Order By: k
                                 Top N: rank() <= 1
                                 ->  Seq Scan on wto_t
 Optimizer: GPORCA
(16 rows)

select p, k, count(*) from (select p, k, v, rank() over (partition by p order by k) rk from wto_t) s
where rk = 1 group by p, k order by p;
 p | k | count 
---+---+-------
 0 | 0 |    10
 1 | 4 |    10
 2 | 3 |    10
 3 | 2 |    10
 4 | 1 |    10
(5 rows)

--
-- row_number() with a unique ordering
--
explain (costs off)
select * from (select p, k, v, row_number() over (partition by p order by k, v) rn from wto_t) s
where rn <= 2 order by p, rn;
                                  QUERY PLAN                                  
------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: p, (row_number() OVER (?))
   ->  Sort
         Sort Key: p, (row_number() OVER (?))
         ->  Result
               Filter: ((row_number() OVER (?)) <= 2)
               ->  WindowAgg
                     Partition By: p
                     Order By: k, v
                     ->  Sort
                           Sort Key: p, k, v
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: p
                                 ->  WindowTopN
                                       Partition By: p
                                       Order By: k, v
                                       Top N: row_number() <= 2
                                       ->  Seq Scan on wto_t
 Optimizer: GPORCA
(19 rows)

select * from (select p, k, v, row_number() over (partition by p order by k, v) rn from wto_t) s
where rn <= 2 order by p, rn;
 p | k |  v   | rn 
---+---+------+----
 0 | 0 | 2000 |  1
 0 | 0 | 4000 |  2
 1 | 4 |  716 |  1
 1 | 4 | 2716 |  2
 2 | 3 | 1037 |  1
 2 | 3 | 3037 |  2
 3 | 2 | 1358 |  1
 3 | 2 | 3358 |  2
 4 | 1 | 1679 |  1
 4 | 1 | 3679 |  2
(10 rows)

--
-- no PARTITION BY: the final window gathers to one segment
--
explain (costs off)
select * from (select k, v, rank() over (order by k) rk from wto_t) s
where rk <= 3 order by k, v;
                         QUERY PLAN                         
------------------------------------------------------------
 Sort
   Sort Key: k, v
   ->  Result
         Filter: ((rank() OVER (?)) <= 3)
         ->  WindowAgg
               Order By: k
               ->  Gather Motion 3:1  (slice1; segments: 3)
                     Merge Key: k
                     ->  Sort
                           Sort Key: k
                           ->  WindowTopN
                                 Order By: k
                                 Top N: rank() <= 3
                                 ->  Seq Scan on wto_t
 Optimizer: GPORCA
(15 rows)

select * from (select k, v, rank() over (order by k) rk from wto_t) s
where rk <= 3 order by k, v;
 k |   v   | rk 
---+-------+----
 0 |  2000 |  1
 0 |  4000 |  1
 0 |  6000 |  1
 0 |  8000 |  1
 0 | 10000 |  1
 0 | 12000 |  1
 0 | 14000 |  1
 0 | 16000 |  1
 0 | 18000 |  1
 0 | 20000 |  1
(10 rows)

--
-- not eligible: ">" filter, a function of the same window that looks past
-- the current row, distribution key equal to the partition column
--
explain (costs off)
select * from (select p, k, v, rank() over (partition by p order by k) rk from wto_t) s
where rk > 3;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Result
         Filter: ((rank() OVER (?)) > 3)
         ->  WindowAgg
               Partition By: p
               Order By: k
               ->  Sort
                     Sort Key: p, k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: p
                           ->  Seq Scan on wto_t
 Optimizer: GPORCA
(12 rows)

explain (costs off)
select * from (
  select p, k, v, rank() over w as rk, lead(v) over w as nxt
  from wto_t window w as (partition by p order by k)
) s where rk <= 2;
                               QUERY PLAN                               
------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   ->  Result
         Filter: ((rank() OVER (?)) <= 2)
         ->  WindowAgg
               Partition By: p
               Order By: k
               ->  Sort
                     Sort Key: p, k
                     ->  Redistribute Motion 3:3  (slice2; segments: 3)
                           Hash Key: p
                           ->  Seq Scan on wto_t
 Optimizer: GPORCA
(12 rows)

-- an aggregate of the same window is fine while its frame ends at the
-- current row (in ROWS mode for row_number(), which may cut a peer group)
explain (costs off)
select * from (
  select p, k, v, rank() over w as rk, sum(v) over w as running
  from wto_t window w as (partition by p order by k)
) s where rk <= 2 order by p, k, v;
                                  QUERY PLAN                                  
------------------------------------------------------------------------------
 Gather Motion 3:1  (slice1; segments: 3)
   Merge Key: p, k, v
   ->  Sort
         Sort Key: p, k, v
         ->  Result
               Filter: ((rank() OVER (?)) <= 2)
               ->  WindowAgg
                     Partition By: p
                     Order By: k
                     ->  Sort
                           Sort Key: p, k
                           ->  Redistribute Motion 3:3  (slice2; segments: 3)
                                 Hash Key: p
                                 ->  WindowTopN
                                       Partition By: p
                                       Order By: k
                                       Top N: rank() <= 2
                                       ->  Seq Scan on wto_t
 Optimizer: GPORCA
(19 rows)

