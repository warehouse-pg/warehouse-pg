 CREATE TABLE          | public.endtest_heap                                          | table
 CREATE TABLE          | public.endtest_split_default                                 | table
 CREATE TABLE          | public.endtest_split_default_dflt                            | table
 ALTER TABLE           | public.endtest_split_default                                 | table
 ALTER TABLE           | public.endtest_split_default_1_prt_endtest_split_default_new | table
 ALTER TABLE           | public.endtest_split_default_dflt                            | table
 ALTER TABLE           | public.endtest_split_default                                 | table
 CREATE TABLE          | public.endtest_split_regular                                 | table
 CREATE TABLE          | public.endtest_split_regular_p1                              | table
 ALTER TABLE           | public.endtest_split_regular                                 | table
 ALTER TABLE           | public.endtest_split_regular_1_prt_endtest_split_jan_mar     | table
 ALTER TABLE           | public.endtest_split_regular_1_prt_endtest_split_apr_jun     | table
 ALTER TABLE           | public.endtest_split_regular                                 | table
 CREATE FUNCTION       | public.write_to_file()                                       | function
 CREATE FUNCTION       | public.read_from_file()                                      | function
 CREATE PROTOCOL       | demoprot_end_test                                            | external protocol
 CREATE DOMAIN         | public.endtest_domain                                        | type
 ALTER TYPE            | public.endtest_domain                                        | type
(19 rows)

DROP EXTERNAL TABLE endtest_ext;
DROP TABLE endtest_heap;
DROP TABLE endtest_split_default;
DROP TABLE endtest_split_regular;
DROP PROTOCOL demoprot_end_test;
DROP DOMAIN endtest_domain;
DROP TABLE regress_ddl_history;
DROP FUNCTION test_event_trigger_end();
