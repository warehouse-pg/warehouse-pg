-- A cursor fetched in pieces: the filter is in place before the first row.
BEGIN;
DECLARE rf_cur CURSOR FOR SELECT f.id FROM rf_fact_aoco f JOIN rf_dim d ON f.k = d.k WHERE d.flag = 3 ORDER BY f.id;
FETCH 3 FROM rf_cur;
