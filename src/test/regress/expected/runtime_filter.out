INSERT INTO rf_fact_wide SELECT id, k::bigint * 1000000 FROM rf_fact_heap;
CREATE TABLE rf_fact_wide_k(LIKE rf_fact_wide) USING ao_column DISTRIBUTED BY (k);
INSERT INTO rf_fact_wide_k SELECT * FROM rf_fact_wide;
