-- Part 2: GPORCA
----------------------------------------------------------------------
SET optimizer = on;
EXPLAIN (COSTS OFF)
SELECT count(*), sum(f.amt) FROM rf_fact_aoco f JOIN rf_dim d ON f.k = d.k WHERE d.flag = 3;
                                QUERY PLAN                                 
---------------------------------------------------------------------------
 Finalize Aggregate
