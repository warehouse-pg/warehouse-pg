-- So does the append-optimized table that SET ACCESS METHOD makes of a heap
-- table: its storage options are those of the WITH clause, then of the GUC,
-- as for CREATE TABLE, and the rewrite fills the directory.
CREATE TABLE bd_guc_heap (a int, b int) USING heap DISTRIBUTED BY (a);
INSERT INTO bd_guc_heap SELECT i, i FROM generate_series(1, 200) i;
CREATE TABLE bd_guc_heap_off (a int, b int) USING heap DISTRIBUTED BY (a);
ALTER TABLE bd_guc_heap SET ACCESS METHOD @amname@;
ALTER TABLE bd_guc_heap_off SET ACCESS METHOD @amname@ WITH (blockdirectory=false);
