-- VACUUM and TRUNCATE keep it as well.
DELETE FROM bd_rewrite WHERE a % 2 = 0;
NOTICE:  One or more columns in the following table(s) do not have statistics: bd_rewrite
HINT:  For non-partitioned tables, run analyze <table_name>(<column_list>). For partitioned tables, run analyze rootpartition <table_name>(<column_list>). See log for columns missing statistics.
VACUUM bd_rewrite;
SELECT * FROM blkdir_status WHERE relname = 'bd_rewrite';
  relname   |                                      reloptions                                       | has_blkdir 
------------+---------------------------------------------------------------------------------------+------------
 bd_rewrite | {blockdirectory=true,blocksize=32768,compresslevel=0,compresstype=none,checksum=true} | t
(1 row)

TRUNCATE bd_rewrite;
SELECT * FROM blkdir_status WHERE relname = 'bd_rewrite';
  relname   |                                      reloptions                                       | has_blkdir 
------------+---------------------------------------------------------------------------------------+------------
 bd_rewrite | {blockdirectory=true,blocksize=32768,compresslevel=0,compresstype=none,checksum=true} | t
(1 row)

-- Unchanged: a directory that exists only because of a dropped index is not
-- carried over by a rewrite.
CREATE TABLE bd_dropped_idx (a int) DISTRIBUTED BY (a);
CREATE INDEX bd_dropped_idx_a ON bd_dropped_idx (a);
DROP INDEX bd_dropped_idx_a;
SELECT * FROM blkdir_status WHERE relname = 'bd_dropped_idx';
    relname     |                            reloptions                             | has_blkdir 
----------------+-------------------------------------------------------------------+------------
 bd_dropped_idx | {blocksize=32768,compresslevel=0,compresstype=none,checksum=true} | t
(1 row)

ALTER TABLE bd_dropped_idx SET WITH (reorganize=true);
SELECT * FROM blkdir_status WHERE relname = 'bd_dropped_idx';
    relname     |                            reloptions                             | has_blkdir 
----------------+-------------------------------------------------------------------+------------
 bd_dropped_idx | {blocksize=32768,compresslevel=0,compresstype=none,checksum=true} | t
(1 row)

