-- The blockdirectory storage option: asking for an append-optimized table's
-- block directory in DDL, instead of getting one only as a side effect of
-- CREATE INDEX.
CREATE SCHEMA blockdirectory_@amname@;
SET search_path="$user",blockdirectory_@amname@,public;
SET default_table_access_method=@amname@;
-- Shows the recorded storage options of a table and whether it has a
-- block directory relation.
CREATE VIEW blkdir_status AS
SELECT c.relname, c.reloptions, a.blkdirrelid <> 0 AS has_blkdir
FROM pg_class c LEFT JOIN pg_appendonly a ON a.relid = c.oid
WHERE c.relnamespace = 'blockdirectory_@amname@'::regnamespace
  AND c.relkind IN ('r', 'm', 'p');
-- Block directory entries of a table on every segment, without the tuple id
-- (which differs between tables).
CREATE FUNCTION blkdir_entries(tab regclass)
RETURNS TABLE (segid int, segno int, columngroup_no int, first_row_no bigint,
               file_offset bigint, row_count bigint)
LANGUAGE sql AS $$
  SELECT gp_segment_id, (gp_toolkit.__gp_aoblkdir(tab)).segno,
         (gp_toolkit.__gp_aoblkdir(tab)).columngroup_no,
         (gp_toolkit.__gp_aoblkdir(tab)).first_row_no,
         (gp_toolkit.__gp_aoblkdir(tab)).file_offset,
         (gp_toolkit.__gp_aoblkdir(tab)).row_count
  FROM gp_dist_random('gp_id')
$$;
--
-- CREATE TABLE WITH (blockdirectory=...)
--
CREATE TABLE bd_create (a int, b text) WITH (blockdirectory=true) DISTRIBUTED BY (a);
CREATE TABLE bd_create_off (a int, b text) WITH (blockdirectory=false) DISTRIBUTED BY (a);
CREATE TABLE bd_create_default (a int, b text) DISTRIBUTED BY (a);
SELECT * FROM blkdir_status WHERE relname LIKE 'bd_create%' ORDER BY relname;
      relname      |                                      reloptions                                       | has_blkdir 
-------------------+---------------------------------------------------------------------------------------+------------
 bd_create         | {blockdirectory=true,blocksize=32768,compresslevel=0,compresstype=none,checksum=true} | t
 bd_create_default | {blocksize=32768,compresslevel=0,compresstype=none,checksum=true}                     | f
 bd_create_off     | {blocksize=32768,compresslevel=0,compresstype=none,checksum=true}                     | f
(3 rows)

-- Not a storage option of heap tables, like blocksize.
CREATE TABLE bd_heap (a int) USING heap WITH (blockdirectory=true) DISTRIBUTED BY (a);
ERROR:  unrecognized parameter "blockdirectory"
-- Not a column encoding option, like checksum.
CREATE TABLE bd_encoding (a int ENCODING (blockdirectory=true)) USING ao_column DISTRIBUTED BY (a);
ERROR:  "blockdirectory" is not a column specific option
CREATE TABLE bd_encoding (a int) USING ao_column WITH (blockdirectory=true) DISTRIBUTED BY (a);
SELECT * FROM blkdir_status WHERE relname = 'bd_encoding';
   relname   |                                      reloptions                                       | has_blkdir 
-------------+---------------------------------------------------------------------------------------+------------
 bd_encoding | {blockdirectory=true,blocksize=32768,compresslevel=0,compresstype=none,checksum=true} | t
(1 row)

DROP TABLE bd_encoding;
-- INSERT and COPY fill the directory of an unindexed table.
INSERT INTO bd_create SELECT i, 'insert' FROM generate_series(1, 1000) i;
SELECT count(*) > 0 AS filled_by_insert FROM blkdir_entries('bd_create');
 filled_by_insert 
------------------
 t
(1 row)

COPY bd_create FROM stdin;
SELECT count(*) AS inserted_rows FROM bd_create;
 inserted_rows 
---------------
          1003
(1 row)

-- The directory a table was created with is exactly what the first index
-- build would have produced: bd_create_idx is loaded the same way and gets
-- its directory from CREATE INDEX.
CREATE TABLE bd_create_idx (a int, b text) DISTRIBUTED BY (a);
INSERT INTO bd_create_idx SELECT i, 'insert' FROM generate_series(1, 1000) i;
COPY bd_create_idx FROM stdin;
CREATE INDEX ON bd_create_idx (a);
SELECT * FROM blkdir_entries('bd_create') EXCEPT SELECT * FROM blkdir_entries('bd_create_idx');
 segid | segno | columngroup_no | first_row_no | file_offset | row_count 
-------+-------+----------------+--------------+-------------+-----------
(0 rows)

SELECT * FROM blkdir_entries('bd_create_idx') EXCEPT SELECT * FROM blkdir_entries('bd_create');
 segid | segno | columngroup_no | first_row_no | file_offset | row_count 
-------+-------+----------------+--------------+-------------+-----------
(0 rows)

-- A later CREATE INDEX reuses the directory instead of creating a new one.
SELECT blkdirrelid AS blkdir_before FROM pg_appendonly WHERE relid = 'bd_create'::regclass \gset
CREATE INDEX ON bd_create (a);
SELECT blkdirrelid = :blkdir_before AS blkdir_reused FROM pg_appendonly WHERE relid = 'bd_create'::regclass;
 blkdir_reused 
---------------
 t
(1 row)

