--
-- gp_default_storage_options
--
-- Tables that exist before the GUC is set, with the operations below that
-- recreate or rewrite a table internally.
CREATE TABLE bd_guc_old (a int, b int, c text) DISTRIBUTED BY (a);
INSERT INTO bd_guc_old SELECT i, i, 'old' FROM generate_series(1, 200) i;
CREATE TABLE bd_guc_old_reorg (a int, b int) DISTRIBUTED BY (a);
INSERT INTO bd_guc_old_reorg SELECT i, i FROM generate_series(1, 200) i;
CREATE TABLE bd_guc_old_part (a int, b int) DISTRIBUTED BY (a)
PARTITION BY RANGE (b) (START (0) END (4) EVERY (2));
INSERT INTO bd_guc_old_part SELECT i, i % 4 FROM generate_series(1, 200) i;
CREATE MATERIALIZED VIEW bd_guc_old_mv AS SELECT a, b FROM bd_guc_old_reorg DISTRIBUTED BY (a);
SET gp_default_storage_options = 'blockdirectory=true';
SHOW gp_default_storage_options;
                     gp_default_storage_options                      
---------------------------------------------------------------------
 blocksize=32768,compresstype=none,checksum=true,blockdirectory=true
(1 row)

CREATE TABLE bd_guc (a int, b text) DISTRIBUTED BY (a);
-- WITH takes precedence over the GUC; an explicit false is not recorded.
CREATE TABLE bd_guc_off (a int, b text) WITH (blockdirectory=false) DISTRIBUTED BY (a);
CREATE TABLE bd_guc_ctas WITH (blockdirectory=false) AS SELECT * FROM bd_guc DISTRIBUTED BY (a);
SELECT * FROM blkdir_status WHERE relname LIKE 'bd_guc%' ORDER BY relname;
