--
-- ALTER TABLE SET (blockdirectory=true) on a loaded table builds the
-- directory in place: the table is not rewritten.
--
CREATE TABLE bd_alter (a int, b text) DISTRIBUTED BY (a);
INSERT INTO bd_alter SELECT i, 'insert' FROM generate_series(1, 1000) i;
INSERT INTO bd_alter SELECT i, 'insert' FROM generate_series(1001, 1500) i;
DELETE FROM bd_alter WHERE a % 10 = 0;
CREATE TEMP TABLE relfilebefore AS
SELECT -1 segid, relfilenode FROM pg_class WHERE relname = 'bd_alter'
UNION SELECT gp_segment_id segid, relfilenode FROM gp_dist_random('pg_class')
WHERE relname = 'bd_alter';
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column(s) named 'segid' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
ALTER TABLE bd_alter SET (blockdirectory=true);
SELECT * FROM blkdir_status WHERE relname = 'bd_alter';
 relname  |                                      reloptions                                       | has_blkdir 
----------+---------------------------------------------------------------------------------------+------------
 bd_alter | {blocksize=32768,compresslevel=0,compresstype=none,checksum=true,blockdirectory=true} | t
(1 row)

CREATE TEMP TABLE relfileafter AS
SELECT -1 segid, relfilenode FROM pg_class WHERE relname = 'bd_alter'
UNION SELECT gp_segment_id segid, relfilenode FROM gp_dist_random('pg_class')
WHERE relname = 'bd_alter';
NOTICE:  Table doesn't have 'DISTRIBUTED BY' clause -- Using column(s) named 'segid' as the Greenplum Database data distribution key for this table.
HINT:  The 'DISTRIBUTED BY' clause determines the distribution of data. Make sure column(s) chosen are the optimal data distribution key to minimize skew.
-- No rewrite: every relfilenode is unchanged.
SELECT * FROM relfilebefore EXCEPT SELECT * FROM relfileafter;
 segid | relfilenode 
-------+-------------
(0 rows)

