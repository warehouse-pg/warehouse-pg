<?xml version="1.0" encoding="UTF-8"?>
<dxl:DXLMessage xmlns:dxl="http://greenplum.com/dxl/2010/12/">
  <dxl:Comment><![CDATA[
    A text = name join must not convert the text side to name: name holds 63
    bytes, so (k)::name truncates a longer text and matches the name it starts
    with (rows 1 and 3 here). texteqname is in the hash opfamily of both text
    and name (text_ops), so each side is hashed as it is. Expect a hash join on
    texteqname / nameeqtext with no Cast in the condition or the hash keys.

    create table t_text (id int, k text, v varchar, c char(70)) distributed by (id);
    create table t_name (id int, n name) distributed by (id);
    insert into t_text values (1, repeat('x', 70), repeat('x', 70), repeat('x', 70)),
      (2, 'short', 'short', 'short'), (3, repeat('é', 40), repeat('é', 40), repeat('é', 40));
    insert into t_name values (1, repeat('x', 63)), (2, 'short'), (3, repeat('é', 31));
    analyze t_text; analyze t_name;

    set optimizer = on;
    explain (costs off) select t.id, n.id from t_text t join t_name n on t.k = n.n;
                                QUERY PLAN
    ------------------------------------------------------------------
     Gather Motion 3:1  (slice1; segments: 3)
       ->  Hash Join
             Hash Cond: (n.n = t.k)
             ->  Redistribute Motion 3:3  (slice2; segments: 3)
                   Hash Key: n.n
                   ->  Seq Scan on t_name n
             ->  Hash
                   ->  Redistribute Motion 3:3  (slice3; segments: 3)
                         Hash Key: t.k
                         ->  Seq Scan on t_text t
     Optimizer: GPORCA
    (11 rows)
  ]]></dxl:Comment>
