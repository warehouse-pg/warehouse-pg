<?xml version="1.0" encoding="UTF-8"?>
<dxl:DXLMessage xmlns:dxl="http://greenplum.com/dxl/2010/12/">
  <dxl:Comment><![CDATA[
    IS NOT DISTINCT FROM between a timestamp and a date column: their operator
    is in no common hash opfamily, so no hash join; the opfamily check of the
    hash-join cast logic must accept the IS DISTINCT FROM node (it asserted).
    Expect a GPORCA plan (nested loop with the IS DISTINCT FROM join filter).

    create table p_ts (id int, x timestamp) distributed by (id);
    create table p_d (id int, y date) distributed by (id);
    insert into p_ts select i, '2026-01-01'::timestamp + (i || ' hours')::interval
      from generate_series(0, 100) i;
    insert into p_d select i, '2026-01-01'::date + i from generate_series(0, 5) i;
    analyze p_ts; analyze p_d;

    set optimizer = on;
    explain (costs off) select count(*) from p_ts a join p_d b on a.x is not distinct from b.y;
                              QUERY PLAN
    ---------------------------------------------------------------
     Aggregate
       ->  Gather Motion 3:1  (slice1; segments: 3)
             ->  Nested Loop
                   Join Filter: (NOT (a.x IS DISTINCT FROM b.y))
                   ->  Broadcast Motion 3:3  (slice2; segments: 3)
                         ->  Seq Scan on p_d b
                   ->  Seq Scan on p_ts a
     Optimizer: GPORCA
    (8 rows)
  ]]></dxl:Comment>
