<?xml version="1.0" encoding="UTF-8"?>
<dxl:DXLMessage xmlns:dxl="http://greenplum.com/dxl/2010/12/">
  <dxl:Comment><![CDATA[
    create table t(id int) distributed by (id);
    insert into t select g from generate_series(1,5) g;
    create table f(id int, a int, b int) distributed by (id);
    insert into f select g, g%20, g%5 from generate_series(1,200) g;
    analyze t; analyze f;

    -- a volatile predicate on the output of a scalar aggregate
    -- must be pushed onto the aggregate (a Result filter above it), not left
    -- in the NAry join as an edge covering a single component, which the
    -- exhaustive join orderer (CJoinOrderDP, the only one enabled here)
    -- dropped in release builds and asserted on in debug builds
    explain select count(*) from t, (select count(*) n from f where a = 15 and b = 3) s where s.n > random();
  ]]>
  </dxl:Comment>
