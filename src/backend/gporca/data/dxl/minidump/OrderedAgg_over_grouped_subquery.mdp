<?xml version="1.0" encoding="UTF-8"?>
<!--
Objective:
Test pre-processing of ordered-set aggs whose input is itself a grouped
(GbAgg) expression, e.g. a subquery with GROUP BY, and there are no other
regular aggregates. SplitOrderedAggsPrj() used to hand back the original
GbAgg child as the "remaining aggregates" expression in this case, and
PexprInputAggPrj2Join() mistook it for a GbAgg computing remaining regular
aggregates, cross-joining its rows with the 1-row percentile result and
duplicating the output row (one copy per group of the subquery).
The plan must combine only the split gp_percentile aggs with a NLJ; the
subquery's GbAgg must not be joined back into the result.

CREATE TABLE foo_grpd(k1 int, m1 numeric, m2 numeric) distributed by (k1);
EXPLAIN SELECT percentile_disc(0.5) WITHIN GROUP (ORDER BY m1) AS p50_m1,
               percentile_disc(0.5) WITHIN GROUP (ORDER BY m2) AS p50_m2
        FROM (SELECT k1, m1, m2 FROM foo_grpd GROUP BY 1,2,3) s;

