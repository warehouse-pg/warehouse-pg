                                             ->  Seq Scan on foo_grpd  (cost=0.00..431.00 rows=1 width=20)
   ->  Sequence  (cost=0.00..2712059915.18 rows=1 width=16)
         ->  Shared Scan (share slice:id 0:1)  (cost=0.00..431.00 rows=1 width=1)
